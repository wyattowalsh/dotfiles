{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppleTextExpansions",
  "type": "object",
  "required": ["version", "expansions", "retired_triggers"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "expansions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expansion"}
    },
    "retired_triggers": {
      "type": "array",
      "items": {"$ref": "#/$defs/retiredTrigger"}
    }
  },
  "$defs": {
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "category",
        "enabled",
        "multiline",
        "sensitivity",
        "shell_safe",
        "surfaces",
        "replaces"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "trigger": {"type": "string", "minLength": 1},
        "phrase": {"type": "string", "minLength": 1},
        "local_value_key": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
        "category": {
          "type": "string",
          "enum": ["identity", "message", "ai", "engineering", "markdown", "symbol"]
        },
        "enabled": {"type": "boolean"},
        "multiline": {"type": "boolean"},
        "sensitivity": {"type": "string", "enum": ["public", "private"]},
        "shell_safe": {"type": "boolean"},
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["text-replacement", "shortcut-library", "expand-anywhere"]
          }
        },
        "replaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "duplicate_phrase_justification": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {
          "required": ["phrase"],
          "properties": {"local_value_key": {"type": "null"}}
        },
        {
          "required": ["local_value_key"],
          "not": {"required": ["phrase"]}
        }
      ]
    },
    "retiredTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "reason"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "replaced_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
