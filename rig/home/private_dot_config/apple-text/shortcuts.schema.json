{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppleShortcuts",
  "type": "object",
  "required": ["version", "compositions", "recipes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "compositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/composition"}
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/recipe"}
    }
  },
  "$defs": {
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "triggers"],
      "properties": {
        "id": {"type": "string", "pattern": "^compose\\.[a-z0-9.-]+$"},
        "label": {"type": "string", "minLength": 1},
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "platforms",
        "inputs",
        "actions",
        "outputs",
        "permissions",
        "siri_phrase",
        "terminal_safety",
        "validation_steps",
        "describe_prompt"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["macOS", "iOS", "iPadOS"]}
        },
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "siri_phrase": {"type": "string", "minLength": 1},
        "mac_hotkey": {"type": ["string", "null"]},
        "children": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "terminal_safety": {"type": "string", "minLength": 1},
        "validation_steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "describe_prompt": {"type": "string", "minLength": 1}
      }
    }
  }
}
