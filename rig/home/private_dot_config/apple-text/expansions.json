      "shell_safe": false,
      "surfaces": [
        "text-replacement",
        "shortcut-library",
        "expand-anywhere"
      ],
      "replaces": [],
      "phrase": "Conduct deep, well-targeted web research using current authoritative sources. Prefer primary documentation, specifications, source repositories, research papers, and llms.txt or llms-full.txt when available. Verify fast-changing facts with exact dates, surface disagreements and evidence gaps, and cite material claims next to the claims they support."
    },
