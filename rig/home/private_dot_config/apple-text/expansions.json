      "shell_safe": false,
      "surfaces": [
        "text-replacement",
        "shortcut-library",
        "expand-anywhere"
      ],
      "replaces": [],
      "phrase": "Continue from the current state without restarting, repeating completed work, or discarding prior decisions. Resolve the remaining gaps, finish every incomplete section, verify the result against the original request, and return the complete final artifact."
    },
    {
      "id": "ai.research",
      "trigger": "airesearch",
      "category": "ai",
      "enabled": true,
      "multiline": false,
