      "surfaces": [
        "text-replacement",
        "shortcut-library",
        "expand-anywhere"
      ],
      "replaces": [],
      "phrase": "Treat every potentially time-sensitive fact as untrusted until verified as of today. Use exact dates, distinguish publication dates from event dates, and state any remaining uncertainty."
