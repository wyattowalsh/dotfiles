#!/usr/bin/env bash
# Open a visible MediaGrab session in Ghostty, with Terminal as fallback.
set -Eeuo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
BACKEND="$HOME/.local/bin/media-grab"
[[ -x "$BACKEND" ]] || {
  /usr/bin/osascript -e 'display alert "MediaGrab is incomplete" message "Apply the dotfiles home state again." as critical' 2>/dev/null || true
  exit 1
}
printf -v COMMAND '%q ' "$BACKEND" "$@"
COMMAND+='; status=$?; printf "\n"; if [ "$status" -eq 0 ]; then printf "MediaGrab finished successfully. You may close this window.\n"; else printf "MediaGrab failed (exit %s). Review the output above.\n" "$status"; fi; (exit "$status")'
terminal_fallback() {
  /usr/bin/osascript - "$COMMAND" <<'OSA'
on run argv
  tell application "Terminal"
    activate
    do script (item 1 of argv)
  end tell
end run
OSA
}
if [[ -d /Applications/Ghostty.app || -d "$HOME/Applications/Ghostty.app" ]] && \
  /usr/bin/osascript -e 'tell application "Ghostty" to get version' >/dev/null 2>&1; then
  if /usr/bin/osascript - "$COMMAND" <<'OSA'
on run argv
  tell application "Ghostty"
    activate
    set cfg to new surface configuration
    set initial working directory of cfg to POSIX path of (path to home folder)
    set win to new window with configuration cfg
    set term to focused terminal of selected tab of win
    try
      set name override of term to "MediaGrab"
    end try
    input text (item 1 of argv) to term
    send key "enter" to term
    focus term
  end tell
end run
OSA
  then
    exit 0
  fi
fi
terminal_fallback
