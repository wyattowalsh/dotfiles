STATE_ENV = "MUSIC_LIKES_STATE_DIR"
LIBRARY_ENV = "MUSIC_LIKES_LIBRARY_ROOT"
BEETS_ENV = "MUSIC_LIKES_BEETS_DB"
FIXTURE_ENV = "MUSIC_LIKES_FIXTURE_DIR"
CLIENT_ID_ENV = "MUSIC_LIKES_SPOTIFY_CLIENT_ID"
CLIENT_SECRET_ENV = "MUSIC_LIKES_SPOTIFY_CLIENT_SECRET"
REFRESH_TOKEN_ENV = "MUSIC_LIKES_SPOTIFY_REFRESH_TOKEN"

LIKED_NAME = "liked.csv"
