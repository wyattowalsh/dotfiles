COMPANION_HEADERS = "EditionId,LikedTrackId,BeetsItemId,Version,Status,Artist,Title,Album,DurationMs,ISRC,Evidence,Reason".split(",")

SPOTIFY_TRACKS_URL = "https://api.spotify.com/v1/me/tracks"
