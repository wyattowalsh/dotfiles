#!/usr/bin/env bash
# Opt-in RustDesk-over-Tailscale remote access for macOS.
# Native vendor services only. No shell-rc startup. No password argv.
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

# launchd PATH is often just /usr/bin:/bin. Prefer an explicit test PATH when
# set; otherwise append Homebrew so mocks at the front of PATH still win.
if [[ -n "${REMOTE_ACCESS_PATH:-}" ]]; then
  export PATH="$REMOTE_ACCESS_PATH"
else
  case ":${PATH:-}:" in
    *:/opt/homebrew/bin:*) ;;
    *) export PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}:/opt/homebrew/bin" ;;
  esac
fi

LABEL_TS="sh.brew.tailscale"
RD_APP_NAME="RustDesk"
RD_FULL_NAME="com.carriez.RustDesk"
RD_BUNDLE_ID="com.carriez.rustdesk"
RD_DAEMON_LABEL="${RD_FULL_NAME}_service"
RD_AGENT_LABEL="${RD_FULL_NAME}_server"
RD_APP="/Applications/RustDesk.app"
RD_BIN="${RD_APP}/Contents/MacOS/RustDesk"
DEST_RUNNER="${HOME}/.local/bin/remote-access"
REPO_RUNNER_REL="rig/home/dot_local/bin/executable_remote-access"
DEFAULT_PORT="21118"
MANAGED_KEYS="direct-server direct-access-port enable-keyboard enable-clipboard enable-file-transfer enable-tunnel enable-terminal allow-remote-config-modification enable-record-session enable-audio enable-lan-discovery approve-mode verification-method whitelist stop-service"

log() {
  printf '[remote-access] %s\n' "$*"
}

die() {
  log "error: $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: remote-access [plan]
       remote-access install --dry-run|--apply
       remote-access enable --dry-run|--apply [--peer <hostname>]
       remote-access doctor
       remote-access disable --dry-run|--apply
       remote-access rollback --dry-run|--apply

  plan       Read-only inventory, selected backend, intended changes, gates.
  install    Targeted packages and dest runner. Does not enable unattended access.
  enable     Start Tailscale brew service, merge nonsecret RustDesk keys, install
             vendor LaunchDaemon/Agent, persist enabled intent.
  doctor     Read-only diagnostics. Exit 0 ok, 1 broken, 3 unsupported, 4 pending.
  disable    Stop RustDesk autostart/listener and persist disabled intent.
  rollback   Restore feature-owned RustDesk settings/plists. Leaves the app.

Mutating commands require --apply and refuse --dry-run combined with --apply.
Password is never accepted as an argument or environment value; set it in the
RustDesk Security UI. Tailscale identity is reused, never reset.
USAGE
}

uname_s() {
  printf '%s\n' "${REMOTE_ACCESS_UNAME:-$(uname -s)}"
}

is_darwin() {
  [[ "$(uname_s)" == "Darwin" ]]
}

state_dir() {
  if [[ -n "${REMOTE_ACCESS_STATE_DIR:-}" ]]; then
    printf '%s\n' "${REMOTE_ACCESS_STATE_DIR}"
    return 0
  fi
  printf '%s\n' "${HOME}/.local/state/dotfiles/remote-access"
}

state_file() {
  printf '%s/state.json\n' "$(state_dir)"
}

lock_dir() {
  printf '%s/lock.d\n' "$(state_dir)"
}

rd_user_pref() {
  printf '%s/Library/Preferences/%s\n' "${HOME}" "${RD_FULL_NAME}"
}

rd_toml2() {
  printf '%s/%s2.toml\n' "$(rd_user_pref)" "${RD_APP_NAME}"
}

rd_toml() {
  printf '%s/%s.toml\n' "$(rd_user_pref)" "${RD_APP_NAME}"
}

sudo_bin() {
  if [[ -n "${REMOTE_ACCESS_SUDO:-}" ]]; then
    printf '%s\n' "${REMOTE_ACCESS_SUDO}"
    return 0
  fi
  command -v sudo
}

repo_root() {
  if [[ -n "${REMOTE_ACCESS_REPO:-}" && -f "${REMOTE_ACCESS_REPO}/${REPO_RUNNER_REL}" ]]; then
    printf '%s\n' "${REMOTE_ACCESS_REPO}"
    return 0
  fi
  return 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

# A failed targeted ps lookup means either "absent" or an inspection error.
# Only a successful, parseable all-process snapshot can prove a PID absent.
lock_owner_status() {
  local pid="$1" snapshot line row_pid row_stat
  snapshot="$(ps -A -o pid=,stat= 2>/dev/null)" || {
    printf 'unknown\n'
    return
  }
  [[ -n "$snapshot" ]] || {
    printf 'unknown\n'
    return
  }
  while IFS= read -r line; do
    if [[ ! "$line" =~ ^[[:space:]]*([0-9]+)[[:space:]]+([^[:space:]]+)[[:space:]]*$ ]]; then
      printf 'unknown\n'
      return
    fi
    row_pid="${BASH_REMATCH[1]}"
    row_stat="${BASH_REMATCH[2]}"
    if [[ "$row_pid" == "$pid" ]]; then
      if [[ "$row_stat" == Z* ]]; then printf 'zombie\n'; else printf 'alive\n'; fi
      return
    fi
  done <<<"$snapshot"
  printf 'absent\n'
}

acquire_lock() {
  local dir pid="" owner_state recovery
  dir="$(lock_dir)"
  recovery="${dir}.recovery"
  mkdir -p "$(state_dir)"
  [[ ! -e "$recovery" ]] || die "another remote-access process holds $(lock_dir) (recovery underway)"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" >"${dir}/pid"
    return 0
  fi
  # A missing/partial pid can be a live process between mkdir and its pid
  # write. Never seize it; an operator must inspect that ambiguous lock.
  [[ -f "${dir}/pid" && ! -L "${dir}/pid" ]] || die "another remote-access process holds $(lock_dir) (owner unknown)"
  pid="$(cat "${dir}/pid")"
  [[ "$pid" =~ ^[0-9]+$ ]] || die "another remote-access process holds $(lock_dir) (owner unknown)"
  owner_state="$(lock_owner_status "$pid")"
  case "$owner_state" in
    absent | zombie) ;;
    *) die "another remote-access process holds $(lock_dir) (owner ${owner_state})" ;;
  esac
  # Only one reaper may inspect and replace a stale lock. Other entrants
  # refuse while recovery is present, even during the remove/mkdir gap.
  mkdir "$recovery" 2>/dev/null || die "another remote-access process holds $(lock_dir) (recovery underway)"
  if [[ "$(cat "${dir}/pid" 2>/dev/null || true)" != "$pid" ]]; then
    rmdir "$recovery"
    die "another remote-access process holds $(lock_dir) (owner changed)"
  fi
  owner_state="$(lock_owner_status "$pid")"
  case "$owner_state" in
    absent | zombie) ;;
    *)
      rmdir "$recovery"
      die "another remote-access process holds $(lock_dir) (owner ${owner_state})"
      ;;
  esac
  rm -rf "$dir"
  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" >"${dir}/pid"
    rmdir "$recovery"
    return 0
  fi
  rmdir "$recovery" || true
  die "another remote-access process holds $(lock_dir)"
}

release_lock() {
  local dir pid=""
  dir="$(lock_dir)"
  pid="$(cat "${dir}/pid" 2>/dev/null || true)"
  if [[ "$pid" == "$$" ]]; then
    rm -rf "$dir"
  fi
}

atomic_write() {
  local dest="$1"
  local dir base tmp
  dir="$(dirname "$dest")"
  base="$(basename "$dest")"
  mkdir -p "$dir"
  tmp="${dir}/.${base}.tmp.$$"
  umask 077
  cat >"$tmp"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$tmp" <<'PY' || true
import os, sys
path = sys.argv[1]
fd = os.open(path, os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
  fi
  mv -f "$tmp" "$dest"
}

run_sudo() {
  local sudo_path
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf '[remote-access] dry-run: sudo'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  sudo_path="$(sudo_bin)" || die "sudo is required for $*"
  if [[ "${DOCTOR_READ_ONLY:-0}" -eq 1 ]]; then
    "$sudo_path" -n "$@"
  else
    "$sudo_path" "$@"
  fi
}

refuse_secrets() {
  if [[ -n "${REMOTE_ACCESS_PASSWORD:-}" || -n "${RUSTDESK_PASSWORD:-}" ]]; then
    die "password environment variables are refused; set the permanent password in the RustDesk Security UI"
  fi
}

python_merge_options() {
  require_cmd python3
  local toml="$1"
  shift
  MANAGED_TOML="$toml" python3 - "$@" <<'PY'
import os, re, sys, tempfile

path = os.environ["MANAGED_TOML"]
updates = {}
argv = sys.argv[1:]
i = 0
while i < len(argv):
    if argv[i] == "--set" and i + 2 < len(argv):
        if any(c in argv[i + 2] for c in "'\r\n"):
            sys.exit("unsafe: unsupported character in native option")
        updates[argv[i + 1]] = argv[i + 2]
        i += 3
        continue
    if argv[i] == "--drop" and i + 1 < len(argv):
        updates[argv[i + 1]] = None
        i += 2
        continue
    sys.exit("usage: --set KEY VALUE | --drop KEY")

text = ""
if os.path.isfile(path):
    with open(path, encoding="utf-8") as handle:
        text = handle.read()

lines = text.splitlines()
out = []
in_options = False
seen = set()
replaced = set()
i = 0
while i < len(lines):
    line = lines[i]
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        if in_options:
            for key, value in updates.items():
                if key not in replaced and value is not None:
                    out.append(f"{key} = '{value}'")
                    replaced.add(key)
        in_options = stripped.lower() == "[options]"
        out.append(line)
        i += 1
        continue
    if in_options:
        match = re.match(r"^([A-Za-z0-9_-]+)\s*=\s*(.*)$", stripped)
        if match:
            key = match.group(1)
            if key in updates:
                value = updates[key]
                replaced.add(key)
                if value is not None:
                    out.append(f"{key} = '{value}'")
                i += 1
                continue
            seen.add(key)
    out.append(line)
    i += 1

if in_options:
    for key, value in updates.items():
        if key not in replaced and value is not None:
            out.append(f"{key} = '{value}'")
            replaced.add(key)
elif updates:
    pending = [(key, value) for key, value in updates.items() if value is not None]
    if pending:
        if out and out[-1].strip() != "":
            out.append("")
        out.append("[options]")
        for key, value in pending:
            out.append(f"{key} = '{value}'")

body = "\n".join(out)
if body and not body.endswith("\n"):
    body += "\n"

directory = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix=".%s." % os.path.basename(path), dir=directory, text=True)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(body)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
}

# Hash only the managed option projection, not the whole vendor file. Unknown
# operator keys are preserved. Duplicate managed keys make a readback ambiguous.
options_fingerprint() {
  python3 - "$(rd_toml2)" "$MANAGED_KEYS" <<'PY'
import hashlib, json, os, re, sys
path, keys = sys.argv[1], set(sys.argv[2].split())
values = {}
if os.path.lexists(path):
    if not os.path.isfile(path) or os.path.islink(path):
        sys.exit(1)
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    in_options = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_options = stripped.lower() == "[options]"
            continue
        if in_options:
            match = re.match(r"^([A-Za-z0-9_-]+)\s*=\s*(.*)$", stripped)
            if match and match.group(1) in keys:
                key = match.group(1)
                if key in values:
                    sys.exit(1)
                values[key] = match.group(2).strip()
print(hashlib.sha256(json.dumps(values, sort_keys=True).encode()).hexdigest())
PY
}

track_options() {
  [[ "$(state_get options.tracked)" == "true" ]] && return 0
  local src backup="" fingerprint
  src="$(rd_toml2)"
  mkdir -p "$(state_dir)/backups" "$(rd_user_pref)"
  chmod 700 "$(state_dir)" "$(state_dir)/backups"
  fingerprint="$(options_fingerprint)" || die "unsafe: cannot inspect native options"
  if [[ -e "$src" ]]; then
    backup="$(state_dir)/backups/RustDesk2.original"
    if [[ -e "$backup" || -L "$backup" ]]; then
      die "unsafe: unclaimed options backup exists"
    fi
    cp -p "$src" "$backup"
    chmod 600 "$backup"
    state_set --set options.created false --set backup.toml2 "$backup" --set backup.sha "$(shasum -a 256 "$backup" | cut -d ' ' -f 1)"
  else
    state_set --set options.created true
  fi
  state_set --set options.expected "$fingerprint" --set options.tracked true
}

# Expected-next is journaled before the atomic TOML replacement. A process
# killed after replacement but before the journal commit can be reconciled on
# the next invocation; any third value is a conflict, never an overwrite.
reconcile_options() {
  [[ "$(state_get options.tracked)" == "true" ]] || return 0
  local actual expected next
  actual="$(options_fingerprint)" || return 1
  expected="$(state_get options.expected)"
  next="$(state_get options.next)"
  if [[ -n "$next" && "$actual" == "$next" ]]; then
    state_set --set options.expected "$next" --set options.next ""
  elif [[ "$actual" == "$expected" ]]; then
    [[ -z "$next" ]] || state_set --set options.next ""
  else
    return 1
  fi
}

option_apply() {
  local src preview next actual original_hash="missing" current_hash="missing"
  track_options
  reconcile_options || {
    log "unsafe: operator-modified native options; refusing overwrite" >&2
    return 1
  }
  src="$(rd_toml2)"
  preview="$(mktemp "$(rd_user_pref)/.RustDesk2.toml.remote-access.XXXXXXXX")"
  if [[ -f "$src" ]]; then
    original_hash="$(shasum -a 256 "$src" | cut -d ' ' -f 1)"
    cp -p "$src" "$preview"
  else
    : >"$preview"
  fi
  if ! python_merge_options "$preview" "$@"; then
    rm -f "$preview"
    return 1
  fi
  next="$(
    python3 - "$preview" "$MANAGED_KEYS" <<'PY'
import hashlib, json, re, sys
keys = set(sys.argv[2].split()); values = {}; in_options = False
for line in open(sys.argv[1], encoding='utf-8'):
    line = line.strip()
    if line.startswith('[') and line.endswith(']'):
        in_options = line.lower() == '[options]'
    elif in_options:
        m = re.match(r'^([A-Za-z0-9_-]+)\s*=\s*(.*)$', line)
        if m and m.group(1) in keys:
            if m.group(1) in values: sys.exit(1)
            values[m.group(1)] = m.group(2).strip()
print(hashlib.sha256(json.dumps(values, sort_keys=True).encode()).hexdigest())
PY
  )" || {
    rm -f "$preview"
    return 1
  }
  state_set --set options.next "$next"
  # Compare the entire source immediately before replacement, not only managed
  # keys: a concurrent unrelated operator edit must not be lost to the preview.
  if [[ -e "$src" || -L "$src" ]]; then
    [[ -f "$src" && ! -L "$src" ]] || {
      rm -f "$preview"
      state_set --set options.next ""
      return 1
    }
    current_hash="$(shasum -a 256 "$src" | cut -d ' ' -f 1)"
  fi
  if [[ "$current_hash" != "$original_hash" ]]; then
    rm -f "$preview"
    state_set --set options.next ""
    log "unsafe: native options changed during CAS preview" >&2
    return 1
  fi
  # mv occurs only after the expected projection has been made durable.
  mv -f "$preview" "$src"
  actual="$(options_fingerprint)" || return 1
  [[ "$actual" == "$next" ]] || return 1
  state_set --set options.expected "$next" --set options.next ""
}

restore_managed_options() {
  local backup key val
  local -a args=()
  backup="$(state_get backup.toml2)"
  if [[ "$(state_get options.created)" == false ]]; then
    if [[ -z "$backup" || ! -f "$backup" || -L "$backup" || "$(shasum -a 256 "$backup" | cut -d ' ' -f 1)" != "$(state_get backup.sha)" ]]; then
      log "unsafe: original native options backup missing or changed; refusing rollback" >&2
      return 1
    fi
  fi
  for key in $MANAGED_KEYS; do
    case "$key" in
      stop-service | direct-server) continue ;; # An off state must stay off.
    esac
    val=""
    if [[ -n "$backup" && -f "$backup" ]]; then
      val="$(python_read_option "$backup" "$key")"
    fi
    if [[ -n "$val" ]]; then args+=(--set "$key" "$val"); else args+=(--drop "$key"); fi
  done
  args+=(--set direct-server N --set stop-service Y)
  option_apply "${args[@]}"
}

python_read_option() {
  require_cmd python3
  local toml="$1"
  local key="$2"
  python3 - "$toml" "$key" <<'PY'
import re, sys
path, key = sys.argv[1], sys.argv[2]
try:
    text = open(path, encoding="utf-8").read()
except OSError:
    sys.exit(0)
in_options = False
for line in text.splitlines():
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        in_options = stripped.lower() == "[options]"
        continue
    if not in_options:
        continue
    match = re.match(r"^([A-Za-z0-9_-]+)\s*=\s*(.*)$", stripped)
    if not match or match.group(1) != key:
        continue
    raw = match.group(2).strip()
    if len(raw) >= 2 and raw[0] in "'\"" and raw[-1] == raw[0]:
        raw = raw[1:-1]
    print(raw)
    break
PY
}

password_present() {
  local toml
  toml="$(rd_toml)"
  [[ -f "$toml" ]] || return 1
  python3 - "$toml" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
in_options = False
for line in text.splitlines():
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        in_options = True
        continue
    if in_options:
        continue
    match = re.match(r"^password\s*=\s*(.*)$", stripped)
    if not match:
        continue
    raw = match.group(1).strip()
    if len(raw) >= 2 and raw[0] in "'\"" and raw[-1] == raw[0]:
        raw = raw[1:-1]
    sys.exit(0 if raw else 1)
sys.exit(1)
PY
}

state_get() {
  local key="$1"
  local file
  file="$(state_file)"
  [[ ! -L "$file" ]] || {
    log "unsafe: symlink state journal" >&2
    return 1
  }
  [[ -f "$file" ]] || {
    [[ ! -e "$file" ]] && return 0
    log "unsafe: invalid state journal" >&2
    return 1
  }
  python3 - "$file" "$key" <<'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path, encoding="utf-8"))
except (OSError, ValueError):
    sys.exit("unsafe: unreadable state journal")
if not isinstance(data, dict):
    sys.exit("unsafe: invalid state journal")
cur = data
for part in key.split("."):
    if not isinstance(cur, dict) or part not in cur:
        sys.exit(0)
    cur = cur[part]
if isinstance(cur, bool):
    print("true" if cur else "false")
elif cur is None:
    pass
else:
    print(cur)
PY
}

state_set() {
  if [[ "${DRY_RUN:-0}" -eq 1 ]]; then
    return 0
  fi
  require_cmd python3
  local file dest tmp
  file="$(state_file)"
  mkdir -p "$(state_dir)"
  chmod 700 "$(state_dir)"
  STATE_FILE="$file" python3 - "$@" <<'PY'
import json, os, sys, tempfile
path = os.environ["STATE_FILE"]
data = {}
if os.path.lexists(path):
    if not os.path.isfile(path) or os.path.islink(path):
        sys.exit("unsafe: invalid state journal")
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        sys.exit("unsafe: unreadable state journal")
if not isinstance(data, dict):
    sys.exit("unsafe: invalid state journal")
argv = sys.argv[1:]
i = 0
while i < len(argv):
    if argv[i] == "--set" and i + 2 < len(argv):
        key, value = argv[i + 1], argv[i + 2]
        cur = data
        parts = key.split(".")
        for part in parts[:-1]:
            nxt = cur.get(part)
            if not isinstance(nxt, dict):
                nxt = {}
                cur[part] = nxt
            cur = nxt
        if value == "true":
            parsed = True
        elif value == "false":
            parsed = False
        else:
            parsed = value
        cur[parts[-1]] = parsed
        i += 3
        continue
    sys.exit("state_set usage: --set KEY VALUE")
directory = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix=".state.", dir=directory, text=True)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
os.replace(tmp, path)
fd = os.open(directory, os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
}

gui_tailscale_present() {
  [[ -d "${REMOTE_ACCESS_TS_APP:-/Applications/Tailscale.app}" ]]
}

formula_tailscale_present() {
  command -v tailscale >/dev/null 2>&1 && command -v tailscaled >/dev/null 2>&1
}

rustdesk_cask_present() {
  [[ -d "$RD_APP" && -x "$RD_BIN" ]]
}

ts_status_line() {
  if ! command -v tailscale >/dev/null 2>&1; then
    printf 'missing\n'
    return 0
  fi
  local err="" rc=0
  err="$(tailscale status 2>&1)" || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    printf 'up\n'
  elif printf '%s' "$err" | grep -qi 'failed to connect'; then
    printf 'daemon-down\n'
  elif printf '%s' "$err" | grep -qi 'logged out'; then
    printf 'logged-out\n'
  else
    printf 'error\n'
  fi
}

summarize_tailscale_json() {
  if ! command -v tailscale >/dev/null 2>&1; then
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    return 0
  fi
  python3 - <<'PY' || true
import json, subprocess, sys
try:
    raw = subprocess.check_output(["tailscale", "status", "--json"], stderr=subprocess.DEVNULL, timeout=8)
    data = json.loads(raw)
except Exception:
    sys.exit(0)
self = data.get("Self") or {}
print("backend=%s" % (data.get("BackendState") or "unknown"))
print("online=%s" % ("true" if self.get("Online") else "false"))
print("hostname=%s" % (self.get("HostName") or ""))
ips = self.get("TailscaleIPs") or []
v4 = [a for a in ips if "." in a and ":" not in a]
v6 = [a for a in ips if ":" in a]
print("self_v4=%s" % (v4[0] if v4 else ""))
print("self_v6=%s" % (v6[0] if v6 else ""))
peers = data.get("Peer") or {}
iphones = []
for peer in peers.values():
    osname = (peer.get("OS") or "").lower()
    host = peer.get("HostName") or ""
    dns = peer.get("DNSName") or ""
    blob = " ".join([osname, host.lower(), dns.lower()])
    if "iphone" in blob or osname in ("ios", "iphone os", "ipados"):
        addrs = peer.get("TailscaleIPs") or []
        iphones.append((host, addrs, peer.get("Online")))
print("peer_count=%d" % len(peers))
print("iphone_count=%d" % len(iphones))
if len(iphones) == 1:
    host, addrs, online = iphones[0]
    print("iphone_host=%s" % host)
    print("iphone_online=%s" % ("true" if online else "false"))
    v4 = [a for a in addrs if "." in a and ":" not in a]
    v6 = [a for a in addrs if ":" in a]
    print("iphone_v4=%s" % (v4[0] if v4 else ""))
    print("iphone_v6=%s" % (v6[0] if v6 else ""))
PY
}

select_peer_ips() {
  local want="$1"
  local host="" v4="" v6="" peer_id="" tailnet="" line rc=0
  SELECTED_PEER_HOST=""
  SELECTED_PEER_ID=""
  SELECTED_TAILNET=""
  SELECTED_PEER_V4=""
  SELECTED_PEER_V6=""
  if ! command -v tailscale >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    return 1
  fi
  while IFS= read -r line; do
    case "$line" in
      rc=*) rc="${line#rc=}" ;;
      host=*) host="${line#host=}" ;;
      v4=*) v4="${line#v4=}" ;;
      v6=*) v6="${line#v6=}" ;;
      id=*) peer_id="${line#id=}" ;;
      tailnet=*) tailnet="${line#tailnet=}" ;;
    esac
  done <<<"$(
    WANT="$want" python3 - <<'PY' || true
import ipaddress, json, os, subprocess, sys
want = (os.environ.get("WANT") or "").lower()
try:
    raw = subprocess.check_output(["tailscale", "status", "--json"], stderr=subprocess.DEVNULL, timeout=8)
    data = json.loads(raw)
except Exception:
    print("rc=1")
    sys.exit(0)
if (data.get("BackendState") or "") != "Running" or not data.get("CurrentTailnet", {}).get("Name"):
    print("rc=1")
    sys.exit(0)
matches = []
for peer in (data.get("Peer") or {}).values():
    osname = (peer.get("OS") or "").lower()
    host = peer.get("HostName") or ""
    dns = peer.get("DNSName") or ""
    blob = " ".join([osname, host.lower(), dns.lower()])
    is_phone = "iphone" in blob or osname in ("ios", "iphone os", "ipados")
    if want:
        if want not in host.lower() and want not in dns.lower():
            continue
    elif not is_phone:
        continue
    addrs = peer.get("TailscaleIPs") or []
    if not isinstance(addrs, list) or any(not isinstance(a, str) for a in addrs) or len(set(addrs)) != len(addrs):
        print("rc=1")
        sys.exit(0)
    try:
        parsed = [ipaddress.ip_address(a) for a in addrs]
    except (ValueError, TypeError):
        print("rc=1")
        sys.exit(0)
    v4 = [str(a) for a in parsed if a.version == 4]
    v6 = [str(a) for a in parsed if a.version == 6]
    matches.append((host, v4[0] if v4 else "", v6[0] if v6 else "", peer.get("Online") is True, peer.get("ID") or ""))
print("count=%d" % len(matches))
if len(matches) > 1:
    print("rc=2")
    sys.exit(0)
if not matches:
    print("rc=1")
    sys.exit(0)
host, v4, v6, online, peer_id = matches[0]
if not online or not peer_id or any(c in peer_id + host for c in '\n\r='):
    print("rc=1")
    sys.exit(0)
print("host=%s" % host)
print("id=%s" % peer_id)
print("tailnet=%s" % data["CurrentTailnet"]["Name"])
print("v4=%s" % v4)
print("v6=%s" % v6)
print("rc=0")
PY
  )"
  if [[ "$rc" != "0" ]]; then
    return "$rc"
  fi
  if [[ -z "$peer_id" || -z "$tailnet" || (-z "$v4" && -z "$v6") ]]; then
    return 1
  fi
  SELECTED_PEER_ID="$peer_id"
  SELECTED_TAILNET="$tailnet"
  SELECTED_PEER_HOST="$host"
  SELECTED_PEER_V4="$v4"
  SELECTED_PEER_V6="$v6"
  return 0
}

check_saved_peer_whitelist() {
  local peer_id="$1" tailnet="$2" white="$3" hostname="$4"
  if [[ -z "$peer_id" || -z "$tailnet" || -z "$hostname" ]] || ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'peer-identity-missing'
    return 0
  fi
  SAVED_PEER_ID="$peer_id" SAVED_TAILNET="$tailnet" SAVED_PEER_WHITE="$white" SAVED_PEER_HOST="$hostname" python3 - <<'PY'
import json, os, subprocess

try:
    raw = subprocess.check_output(["tailscale", "status", "--json"], stderr=subprocess.DEVNULL, timeout=8)
    data = json.loads(raw)
    if not isinstance(data, dict):
        raise ValueError("invalid tailnet status")
    current = data.get("CurrentTailnet")
    if not isinstance(current, dict) or not isinstance(current.get("Name"), str) or not current["Name"]:
        raise ValueError("invalid tailnet identity")
    peers = data.get("Peer") or {}
    if not isinstance(peers, dict) or any(not isinstance(peer, dict) for peer in peers.values()):
        raise ValueError("invalid peer status")
    matches = [peer for peer in peers.values() if peer.get("ID") == os.environ["SAVED_PEER_ID"]]
    if (current["Name"] != os.environ["SAVED_TAILNET"] or len(matches) != 1
            or matches[0].get("HostName") != os.environ["SAVED_PEER_HOST"]):
        print("peer-stale")
    elif matches[0].get("Online") is not True:
        print("peer-offline")
    else:
        live = matches[0].get("TailscaleIPs") or []
        saved = os.environ["SAVED_PEER_WHITE"].split(",")
        if (not isinstance(live, list) or not live
                or any(not isinstance(ip, str) or not ip for ip in live)
                or len(set(live)) != len(live)
                or len(set(saved)) != len(saved) or set(live) != set(saved)):
            print("whitelist-mismatch")
except (OSError, ValueError, TypeError, AttributeError, subprocess.SubprocessError):
    print("peer-status-unavailable")
PY
}

whitelist_value() {
  local parts=""
  if [[ -n "${SELECTED_PEER_V4:-}" ]]; then
    parts="${SELECTED_PEER_V4}"
  fi
  if [[ -n "${SELECTED_PEER_V6:-}" ]]; then
    if [[ -n "$parts" ]]; then
      parts="${parts},${SELECTED_PEER_V6}"
    else
      parts="${SELECTED_PEER_V6}"
    fi
  fi
  [[ -n "$parts" ]] || return 1
  printf '%s\n' "$parts"
}

competing_vpn() {
  if pgrep -x NordVPN >/dev/null 2>&1; then
    printf 'NordVPN\n'
  fi
}

plist_daemon_body() {
  cat <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.carriez.RustDesk_service</string>
	<key>AssociatedBundleIdentifiers</key>
	<string>com.carriez.rustdesk</string>
        <key>KeepAlive</key>
        <true/>
        <key>ThrottleInterval</key>
        <integer>1</integer>
        <key>ProgramArguments</key>
        <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/Applications/RustDesk.app/Contents/MacOS/service</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>WorkingDirectory</key>
        <string>/Applications/RustDesk.app/Contents/MacOS/</string>
        <key>StandardErrorPath</key>
        <string>/tmp/rustdesk_service.err</string>
        <key>StandardOutPath</key>
        <string>/tmp/rustdesk_service.out</string>
    </dict>
</plist>
PLIST
}

plist_agent_body() {
  cat <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.carriez.RustDesk_server</string>
	<key>AssociatedBundleIdentifiers</key>
	<string>com.carriez.rustdesk</string>
        <key>LimitLoadToSessionType</key>
        <array>
          <string>LoginWindow</string>
          <string>Aqua</string>
        </array>
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
            <key>AfterInitialDemand</key>
            <false/>
        </dict>
        <key>ThrottleInterval</key>
        <integer>1</integer>
        <key>RunAtLoad</key>
        <true/>
        <key>ProgramArguments</key>
        <array>
            <string>/Applications/RustDesk.app/Contents/MacOS/RustDesk</string>
            <string>--server</string>
        </array>
        <key>WorkingDirectory</key>
        <string>/Applications/RustDesk.app/Contents/MacOS/</string>
        <key>ProcessType</key>
        <string>Interactive</string>
    </dict>
</plist>
PLIST
}

plist_disk_path() {
  printf '%s%s\n' "${REMOTE_ACCESS_PLIST_ROOT:-}" "$1"
}

plist_digest() {
  local path
  path="$(plist_disk_path "$1")"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  shasum -a 256 "$path" | cut -d ' ' -f 1
}

# An exclusive create is the only ownership boundary. A matching digest by
# itself proves content, not who created the file. A killed copy before the
# journal commit leaves an ambiguous, unclaimed plist for operator review;
# never adopt or delete it on re-entry.
claim_plist() {
  local name="$1" source="$2" target="$3" digest actual="" prior
  lifecycle_hold || return $?
  digest="$(shasum -a 256 "$source" | cut -d ' ' -f 1)"
  prior="$(state_get "plists.${name}.sha")"
  if [[ -n "$prior" && "$(state_get "plists.${name}.created")" != true ]]; then
    die "unsafe: legacy ${name} claim has no exclusive-create proof; operator review required"
  fi
  if [[ -e "$(plist_disk_path "$target")" || -L "$(plist_disk_path "$target")" ]]; then
    [[ -n "$prior" ]] || die "unsafe: unowned ${name} vendor plist exists"
    actual="$(plist_digest "$target")" || die "unsafe: unreadable ${name} vendor plist"
    [[ "$actual" == "$prior" && "$digest" == "$prior" ]] || die "unsafe: operator-modified ${name} vendor plist"
    return 0
  fi
  [[ -z "$prior" ]] || die "unsafe: claimed ${name} vendor plist disappeared; operator review required"
  # POSIX noclobber opens with O_EXCL: cp -n can succeed without copying when
  # another writer creates the target between the probe and the copy.
  # shellcheck disable=SC2016 # arguments expand in the privileged shell
  run_sudo /bin/sh -c 'set -C; /bin/cat "$1" > "$2"' remote-access "$source" "$target"
  actual="$(plist_digest "$target")" || die "unsafe: ${name} plist copy not verified"
  [[ "$actual" == "$digest" ]] || die "unsafe: ${name} plist raced with another writer"
  state_set --set "plists.${name}.sha" "$digest" --set "plists.${name}.created" true
  run_sudo /usr/sbin/chown 0:0 "$target"
  run_sudo /bin/chmod 644 "$target"
  [[ "$(plist_digest "$target")" == "$digest" ]] || die "unsafe: ${name} plist changed during install"
}

check_owned_plists() {
  local name path expected actual
  for name in daemon agent; do
    if [[ "$name" == daemon ]]; then
      path="/Library/LaunchDaemons/${RD_DAEMON_LABEL}.plist"
    else path="/Library/LaunchAgents/${RD_AGENT_LABEL}.plist"; fi
    expected="$(state_get "plists.${name}.sha")"
    [[ -n "$expected" && "$(state_get "plists.${name}.created")" == true ]] || return 1
    actual="$(plist_digest "$path")" || return 1
    [[ "$actual" == "$expected" ]] || return 1
  done
}

write_vendor_plists() {
  local daemon_path="/Library/LaunchDaemons/${RD_DAEMON_LABEL}.plist"
  local agent_path="/Library/LaunchAgents/${RD_AGENT_LABEL}.plist"
  local tmp_d tmp_a
  if [[ "${DRY_RUN}" -ne 1 ]]; then
    lifecycle_hold || return $?
  fi
  tmp_d="$(state_dir)/daemon.plist"
  tmp_a="$(state_dir)/agent.plist"
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would install ${daemon_path} and ${agent_path} from vendor 1.4.9 templates"
    return 0
  fi
  plist_daemon_body | atomic_write "$tmp_d"
  plist_agent_body | atomic_write "$tmp_a"
  if grep -Eiq 'password|--password' "$tmp_d" "$tmp_a"; then
    die "refusing to install plists that mention a password"
  fi
  claim_plist daemon "$tmp_d" "$daemon_path"
  claim_plist agent "$tmp_a" "$agent_path"
  check_owned_plists || die "unsafe: vendor plist ownership changed before startup"
  # A prior disable persists in launchd across reboots. Only an explicit enable
  # transaction may clear an override that this journal proves we set.
  restore_owned_launchd_override "system/${RD_DAEMON_LABEL}"
  run_sudo launchctl bootstrap system "$daemon_path"
  restore_owned_launchd_override "gui/$(id -u)/${RD_AGENT_LABEL}"
  run_sudo launchctl bootstrap "gui/$(id -u)" "$agent_path"
  check_owned_plists || die "unsafe: vendor plist ownership changed during startup"
}

remove_vendor_plists() {
  local name path
  lifecycle_hold || return $?
  for name in daemon agent; do
    if [[ "$name" == daemon ]]; then
      path="/Library/LaunchDaemons/${RD_DAEMON_LABEL}.plist"
    else path="/Library/LaunchAgents/${RD_AGENT_LABEL}.plist"; fi
    if [[ -e "$(plist_disk_path "$path")" || -L "$(plist_disk_path "$path")" ]]; then
      log "rollback incomplete: ${name} plist retained for attended review; ownership claims preserved" >&2
      return 1
    fi
  done
  for name in daemon agent; do
    state_set --set "plists.${name}.sha" "" --set "plists.${name}.created" false
  done
}

sync_dest_runner() {
  local src=""
  if src="$(repo_root)"; then
    src="${src}/${REPO_RUNNER_REL}"
  else
    src=""
  fi
  if [[ -z "$src" || ! -f "$src" ]]; then
    log "repo source missing; skip dest runner sync"
    return 0
  fi
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would /bin/cp -f ${src} ${DEST_RUNNER}"
    return 0
  fi
  mkdir -p "$(dirname "${DEST_RUNNER}")"
  /bin/cp -f "$src" "$DEST_RUNNER"
  /bin/chmod +x "$DEST_RUNNER"
  log "synced dest runner"
}

install_rustdesk_cask() {
  if rustdesk_cask_present; then
    log "RustDesk.app already present"
    return 0
  fi
  require_cmd brew
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would brew install --cask rustdesk"
    return 0
  fi
  brew install --cask rustdesk
  state_set --set owned.rustdesk_cask true
}

ensure_tailscale_backend() {
  if gui_tailscale_present; then
    log "Tailscale.app present — preserving GUI variant; will not start brew services"
    state_set --set backend gui-app
    return 0
  fi
  if ! formula_tailscale_present; then
    require_cmd brew
    if [[ "${DRY_RUN}" -eq 1 ]]; then
      log "dry-run: would brew install tailscale"
      return 0
    fi
    brew install tailscale
  fi
  state_set --set backend brew-formula-tailscaled
}

start_tailscale_service() {
  if gui_tailscale_present; then
    log "GUI Tailscale variant in use; not registering Homebrew service"
    return 0
  fi
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would sudo brew services start tailscale"
    return 0
  fi
  local was
  was="$(ts_status_line)"
  if [[ "$was" == "up" || "$was" == "error" || "$was" == "logged-out" ]]; then
    state_set --set owned.tailscale_started_by_us false
    log "tailscaled already reachable; leaving lifecycle owner in place"
    return 0
  fi
  require_cmd brew
  run_sudo brew services start tailscale
  state_set --set owned.tailscale_started_by_us true
  local i=0
  local max="${REMOTE_ACCESS_TS_WAIT:-20}"
  while [[ "$i" -lt "$max" ]]; do
    if [[ "$(ts_status_line)" != "daemon-down" ]]; then
      break
    fi
    sleep 1
    i=$((i + 1))
  done
}

configure_tailscale_operator() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would tailscale set --operator=$(id -un) (no identity reset)"
    return 0
  fi
  if [[ "$(ts_status_line)" == "daemon-down" ]]; then
    log "tailscaled not up yet; operator remains a pending gate"
    return 0
  fi
  if tailscale set --operator="$(id -un)"; then
    log "set tailscale operator to $(id -un)"
  else
    log "tailscale set --operator needs login first"
  fi
}

merge_rustdesk_options() {
  local port whitelist
  port="${REMOTE_ACCESS_PORT:-$DEFAULT_PORT}"
  [[ "$port" =~ ^[0-9]+$ && "$port" -gt 0 && "$port" -le 65535 ]] || die "invalid direct-access port"
  whitelist="$(whitelist_value)" || die "refusing to enable without a selected controller Tailscale address (not allow-all)"
  if [[ "$whitelist" == "," || -z "$whitelist" ]]; then
    die "refusing allow-all whitelist"
  fi
  mkdir -p "$(rd_user_pref)"
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would merge nonsecret RustDesk options (direct IP, keyboard, clipboard, password approve, lan-discovery off, whitelist=selected-peer)"
    return 0
  fi
  option_apply \
    --set direct-server Y \
    --set direct-access-port "$port" \
    --set enable-keyboard Y \
    --set enable-clipboard Y \
    --set enable-file-transfer N \
    --set enable-tunnel N \
    --set enable-terminal N \
    --set allow-remote-config-modification N \
    --set enable-record-session N \
    --set enable-audio Y \
    --set enable-lan-discovery N \
    --set approve-mode password \
    --set verification-method use-permanent-password \
    --set whitelist "$whitelist"
  state_set --set peer.hostname "$SELECTED_PEER_HOST" --set peer.id "$SELECTED_PEER_ID" --set peer.tailnet "$SELECTED_TAILNET" --set last.port "$port"
  log "merged nonsecret RustDesk options"
}

open_permission_surfaces() {
  if [[ "${REMOTE_ACCESS_SKIP_OPEN:-}" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    log "no TTY: open RustDesk → Settings → Security, then System Settings → Privacy & Security"
    return 0
  fi
  if [[ -d "$RD_APP" ]]; then
    open -a "$RD_APP_NAME" >/dev/null 2>&1 || true
  fi
  open "x-apple.systempreferences:com.apple.preference.security" >/dev/null 2>&1 || true
}

print_inventory() {
  log "host: $(uname_s) $(uname -m 2>/dev/null || true)"
  if is_darwin; then
    sw_vers 2>/dev/null | while IFS= read -r line; do
      log "macos: $line"
    done
  fi
  log "FileVault: $(fdesetup status 2>/dev/null || echo unknown)"
  if gui_tailscale_present; then
    log "Tailscale variant: GUI app present (will not migrate)"
  elif formula_tailscale_present; then
    log "Tailscale variant: Homebrew formula $(tailscale version 2>/dev/null | head -n 1)"
  else
    log "Tailscale variant: not installed"
  fi
  log "tailscale daemon: $(ts_status_line)"
  log "RustDesk app: $(rustdesk_cask_present && echo present || echo missing)"
  log "intent: $(state_get intent || echo unset)"
  local vpn
  vpn="$(competing_vpn || true)"
  if [[ -n "$vpn" ]]; then
    log "competing VPN process: $vpn (left running)"
  fi
  summarize_tailscale_json | while IFS= read -r line; do
    case "$line" in
      iphone_v4=* | iphone_v6=* | self_v4=* | self_v6=*)
        log "net: ${line%%=*}=<redacted-in-plan>"
        ;;
      *)
        log "net: $line"
        ;;
    esac
  done
}

pending_gates() {
  local gates=""
  if ! is_darwin; then
    printf 'unsupported-platform\n'
    return 0
  fi
  if gui_tailscale_present && formula_tailscale_present; then
    gates="${gates}tailscale-variant-conflict "
  fi
  local ts_line backend=""
  ts_line="$(ts_status_line)"
  case "$ts_line" in
    daemon-down) gates="${gates}tailscale-daemon " ;;
    missing) gates="${gates}tailscale-missing " ;;
    logged-out) gates="${gates}tailscale-login " ;;
  esac
  backend="$(summarize_tailscale_json | awk -F= '/^backend=/{print $2}')"
  if [[ "$backend" == "NeedsLogin" || -z "$backend" || "$backend" == "Stopped" ]]; then
    if [[ "$ts_line" == "up" || "$ts_line" == "error" ]]; then
      gates="${gates}tailscale-login "
    fi
  fi
  if ! rustdesk_cask_present; then
    gates="${gates}rustdesk-app "
  fi
  if ! password_present; then
    gates="${gates}rustdesk-password-ui "
  fi
  if [[ "$(state_get peer.hostname)" == "" ]]; then
    if ! select_peer_ips "${PEER:-}" 2>/dev/null; then
      gates="${gates}controller-peer "
    fi
  fi
  gates="${gates}screen-recording-unknown accessibility-unknown input-monitoring-unknown"
  printf '%s\n' "$gates"
}

cmd_plan() {
  print_inventory
  if gui_tailscale_present; then
    log "backend: preserving existing GUI Tailscale.app (does not run before login; no brew service)"
  else
    log "backend: Homebrew formula tailscaled via sudo brew services (Brewfile SSOT; do not also install the upstream macOS system daemon)"
  fi
  log "rustdesk lifecycle: vendor LaunchDaemon ${RD_DAEMON_LABEL} + LaunchAgent ${RD_AGENT_LABEL} (bundle ${RD_BUNDLE_ID}; official 1.4.9 templates). --install-service on macOS only checks plists; it does not install."
  log "tailscale brew label: ${LABEL_TS} (formula backend only)"
  log "intended: selected controller RustDesk -> Tailscale -> Mac direct-IP listener (default port ${DEFAULT_PORT}; default controller is one iPhone, MBA migration requires --peer MBP)"
  log "will not: self-hosted ID/relay servers, Funnel, Serve, subnet router, exit node, Tailscale SSH, UPnP, MDM, TCC edits, password argv"
  log "startup: tailscaled can run at LoginWindow after FileVault unlock; not before FileVault unlock"
  log "bootstrap: packages only with --with-remote-access; never auto-enable"
  log "pending: $(pending_gates)"
}

cmd_install() {
  if ! is_darwin; then
    die "install is macOS-only"
  fi
  if [[ "$DRY_RUN" -eq 0 && -n "$(state_get journal.phase)" && "$(state_get journal.phase)" != steady ]]; then
    guarded_off || return 1
    state_set --set intent disabled --set journal.phase steady
  fi
  ensure_tailscale_backend
  install_rustdesk_cask
  sync_dest_runner
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would persist intent=installed (not enabled)"
    return 0
  fi
  if [[ "$(state_get intent)" == "disabled" ]]; then
    log "intent remains disabled; install does not re-enable"
    return 0
  fi
  if [[ "$(state_get intent)" == "enabled" ]]; then
    log "intent remains enabled; install cannot silently change active lifecycle"
    return 0
  fi
  state_set --set intent installed --set feature rustdesk-tailscale
  log "installed packages/artifacts; unattended access is still off until enable --apply"
}

# A launchd override is the durable half of safe-off: bootout alone only
# unloads the current job, while the owned RunAtLoad plist survives a reboot.
# Never disable a label backed by a preexisting, modified, or unclaimed plist.
off_plist_claim() {
  local target="$1" name path expected actual created
  case "$target" in
    "system/${RD_DAEMON_LABEL}")
      name=daemon
      path="/Library/LaunchDaemons/${RD_DAEMON_LABEL}.plist"
      ;;
    "gui/$(id -u)/${RD_AGENT_LABEL}")
      name=agent
      path="/Library/LaunchAgents/${RD_AGENT_LABEL}.plist"
      ;;
    *) return 1 ;;
  esac
  expected="$(state_get "plists.${name}.sha")" || return 1
  created="$(state_get "plists.${name}.created")" || return 1
  if [[ ! -e "$(plist_disk_path "$path")" && ! -L "$(plist_disk_path "$path")" ]]; then
    if [[ -n "$expected" || "$created" == true ]]; then
      log "unsafe: claimed ${name} vendor plist disappeared" >&2
      return 1
    fi
    printf 'absent\n'
    return 0
  fi
  actual="$(plist_digest "$path")" || {
    log "unsafe: unreadable ${name} vendor plist" >&2
    return 1
  }
  if [[ -z "$expected" || "$created" != true || "$actual" != "$expected" ]]; then
    log "unsafe: ${name} vendor plist is not fingerprint-owned; preserving it" >&2
    return 1
  fi
  printf 'owned\n'
}

# print-disabled is a domain query, not a loaded-job query. Require exactly
# one exact-label entry; absent, duplicate, malformed, or denied is unknown.
# macOS versions emit disabled/enabled or true/false for the override.
launchctl_disabled_status() {
  local target="$1" domain="${1%/*}" label="${1##*/}" output line found=0 state=unknown value
  local in_map=0 malformed=0
  local pattern='^[[:space:]]*"([^"]+)"[[:space:]]*=>[[:space:]]*(.*)$'
  local close_pattern='^[[:space:]]*}[[:space:]]*$'
  output="$(run_sudo launchctl print-disabled "$domain" 2>/dev/null)" || {
    printf 'unknown\n'
    return
  }
  # A well-formed empty map means no override. An unrecognized response does
  # not; do not treat failed inspection or malformed entries as enabled.
  if [[ "$output" != *'disabled services = {'* || "$output" != *$'\n}'* ]]; then
    printf 'unknown\n'
    return
  fi
  while IFS= read -r line; do
    if [[ "$line" == *'disabled services = {'* ]]; then
      [[ "$in_map" -eq 0 ]] || malformed=1
      in_map=1
    elif [[ "$in_map" -eq 1 ]]; then
      if [[ "$line" =~ $close_pattern ]]; then
        in_map=2
      elif [[ "$line" =~ ^[[:space:]]*$ ]]; then
        continue
      elif [[ "$line" =~ $pattern ]]; then
        value="${BASH_REMATCH[2]}"
        case "$value" in disabled | true | enabled | false) ;; *) malformed=1 ;; esac
        [[ "${BASH_REMATCH[1]}" == "$label" ]] || continue
        found=$((found + 1))
        case "$value" in disabled | true) state=disabled ;; enabled | false) state=enabled ;; *) state=unknown ;; esac
      else
        malformed=1
      fi
    fi
  done <<<"$output"
  if [[ "$malformed" -eq 1 || "$in_map" -ne 2 || "$found" -ne 1 ]]; then
    state="unknown"
    [[ "$malformed" -eq 0 && "$in_map" -eq 2 && "$found" -eq 0 ]] && state="unset"
  fi
  printf '%s\n' "$state"
}

launchd_unit_name() {
  case "$1" in
    "system/${RD_DAEMON_LABEL}") printf 'daemon\n' ;;
    "gui/$(id -u)/${RD_AGENT_LABEL}") printf 'agent\n' ;;
    *) return 1 ;;
  esac
}

durable_disable_unit() {
  local target="$1" claim name status pending owned
  lifecycle_hold || return $?
  claim="$(off_plist_claim "$target")" || return 1
  [[ "$claim" == absent ]] && return 0
  name="$(launchd_unit_name "$target")" || return 1
  status="$(launchctl_disabled_status "$target")"
  pending="$(state_get "launchd.${name}.disable_pending")" || return 1
  owned="$(state_get "launchd.${name}.disabled_by_us")" || return 1
  case "$status" in
    disabled)
      # Never seize an operator's preexisting disabled override. A pending
      # uncommitted write has unknown authorship, so it cannot be enabled.
      [[ "$pending" != true ]] || return 1
      return 0
      ;;
    unset | enabled) ;;
    *) return 1 ;;
  esac
  # Crash before the command leaves pending provenance; crash after it but
  # before the confirmed commit leaves a disabled override we will not adopt.
  state_set --set "launchd.${name}.disable_pending" true || return 1
  run_sudo launchctl disable "$target" || return 1
  [[ "$(launchctl_disabled_status "$target")" == disabled ]] || return 1
  state_set --set "launchd.${name}.disabled_by_us" true --set "launchd.${name}.disable_pending" false
}

restore_owned_launchd_override() {
  local target="$1" name claim status owned pending
  lifecycle_hold || return $?
  claim="$(off_plist_claim "$target")" || return 1
  [[ "$claim" == owned ]] || return 1
  name="$(launchd_unit_name "$target")" || return 1
  status="$(launchctl_disabled_status "$target")"
  owned="$(state_get "launchd.${name}.disabled_by_us")" || return 1
  pending="$(state_get "launchd.${name}.disable_pending")" || return 1
  [[ "$pending" != true ]] || {
    log "unsafe: ${name} launchd override provenance pending" >&2
    return 1
  }
  case "$status" in
    disabled)
      [[ "$owned" == true ]] || {
        log "unsafe: operator-disabled ${name} launchd override preserved" >&2
        return 1
      }
      run_sudo launchctl enable "$target" || return 1
      status="$(launchctl_disabled_status "$target")"
      [[ "$status" == enabled || "$status" == unset ]] || return 1
      state_set --set "launchd.${name}.disabled_by_us" false
      ;;
    unset | enabled)
      [[ "$owned" != true ]] || {
        log "unsafe: ${name} launchd override changed outside journal" >&2
        return 1
      }
      ;;
    *)
      log "unsafe: ${name} launchd override state unknown" >&2
      return 1
      ;;
  esac
}

durable_disable_check_only() {
  local target="$1" claim name pending
  claim="$(off_plist_claim "$target")" || return 1
  [[ "$claim" == absent ]] && return 0
  name="$(launchd_unit_name "$target")" || return 1
  pending="$(state_get "launchd.${name}.disable_pending")" || return 1
  [[ "$pending" != true && "$(launchctl_disabled_status "$target")" == disabled ]]
}

# A positive launchctl print means loaded; 113 is launchd's not-found result.
# Other failures (including permission errors) are unknown, not proof of off.
bootout_unit() {
  local target="$1" rc=0 name path expected actual
  lifecycle_hold || return $?
  run_sudo launchctl print "$target" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -eq 113 ]]; then return 0; fi
  [[ "$rc" -eq 0 ]] || return 1
  case "$target" in
    "system/${RD_DAEMON_LABEL}")
      name=daemon
      path="/Library/LaunchDaemons/${RD_DAEMON_LABEL}.plist"
      ;;
    "gui/$(id -u)/${RD_AGENT_LABEL}")
      name=agent
      path="/Library/LaunchAgents/${RD_AGENT_LABEL}.plist"
      ;;
    *) return 1 ;;
  esac
  expected="$(state_get "plists.${name}.sha")"
  actual="$(plist_digest "$path")" || return 1
  if [[ -z "$expected" || "$(state_get "plists.${name}.created")" != true || "$expected" != "$actual" ]]; then
    log "unsafe: loaded ${name} job is not fingerprint-owned; preserving it" >&2
    return 1
  fi
  run_sudo launchctl bootout "$target" >/dev/null 2>&1 || return 1
  rc=0
  run_sudo launchctl print "$target" >/dev/null 2>&1 || rc=$?
  [[ "$rc" -eq 113 ]]
}

# This is a separate all-ports check, not a check of only the configured port.
# lsof's empty exit 1 is normal; permission/inspection failures remain unknown.
off_listener_status() {
  local records rc=0 line pid exe_records exe_line found marker
  local record_pid="" command_seen=0 groups=0
  # The root shell emits a sentinel even when lsof finds zero matches (exit 1).
  # A failed sudo -n cannot emit it, so denial is never mistaken for absence.
  # shellcheck disable=SC2016 # script is evaluated by the privileged shell
  records="$(run_sudo /bin/sh -c 'lsof -nP -iTCP -sTCP:LISTEN -Fpc 2>&1; rc=$?; printf "\n__REMOTE_ACCESS_LSOF_RC=%s\n" "$rc"' 2>&1)" || {
    printf 'unknown\n'
    return
  }
  marker="${records##*$'\n'}"
  case "$marker" in
    __REMOTE_ACCESS_LSOF_RC=0 | __REMOTE_ACCESS_LSOF_RC=1) rc="${marker##*=}" ;;
    *)
      printf 'unknown\n'
      return
      ;;
  esac
  records="${records%$'\n'*}"
  if [[ "$rc" -eq 1 && -z "$records" ]]; then
    printf 'absent\n'
    return
  fi
  # Exit 0 promises matching process records. Empty success is incomplete
  # inspection, not the explicit no-match result (empty exit 1) above.
  if [[ "$rc" -ne 0 || -z "$records" ]]; then
    printf 'unknown\n'
    return
  fi
  # Validate every requested process/command group before interpreting absence.
  # Partial successful output cannot exclude a RustDesk listener.
  while IFS= read -r line; do
    case "$line" in
      p*)
        if [[ -n "$record_pid" && "$command_seen" -ne 1 ]]; then
          printf 'unknown\n'
          return
        fi
        record_pid="${line#p}"
        if [[ ! "$record_pid" =~ ^[1-9][0-9]{0,9}$ ]]; then
          printf 'unknown\n'
          return
        fi
        command_seen=0
        groups=$((groups + 1))
        ;;
      c*)
        if [[ -z "$record_pid" || "$command_seen" -ne 0 || "$line" == c ]]; then
          printf 'unknown\n'
          return
        fi
        command_seen=1
        ;;
      "") ;;
      *)
        printf 'unknown\n'
        return
        ;;
    esac
  done <<<"$records"
  if [[ "$groups" -eq 0 || "$command_seen" -ne 1 ]]; then
    printf 'unknown\n'
    return
  fi
  while IFS= read -r line; do
    case "$line" in
      cRustDesk | cservice)
        printf 'alive\n'
        return
        ;;
      p[0-9]*)
        pid="${line#p}"
        exe_records="$(run_sudo lsof -nP -a -p "$pid" -d txt -Fn 2>&1)" || {
          printf 'unknown\n'
          return
        }
        found=0
        while IFS= read -r exe_line; do
          case "$exe_line" in
            "n${RD_BIN}" | "n${RD_APP}/Contents/MacOS/service")
              printf 'alive\n'
              return
              ;;
            n*) found=1 ;;
          esac
        done <<<"$exe_records"
        [[ "$found" -eq 1 ]] || {
          printf 'unknown\n'
          return
        }
        ;;
      c* | "") ;;
      *)
        printf 'unknown\n'
        return
        ;;
    esac
  done <<<"$records"
  printf 'absent\n'
}

# All transitions stage native stop before touching direct-IP options or plists.
# The durable phase is set first so a killed invocation is never steady-state.
guarded_off() {
  local failed=0 i max status
  lifecycle_hold || return $?
  state_set --set journal.phase stopping || return 1
  if [[ -f "$(rd_toml2)" ]] || rustdesk_cask_present || [[ "$(state_get options.tracked)" == true ]]; then
    if ! option_apply --set stop-service Y || [[ "$(python_read_option "$(rd_toml2)" stop-service)" != Y ]]; then
      log "unsafe: native stop write/readback failed" >&2
      failed=1
    elif ! option_apply --set direct-server N || [[ "$(python_read_option "$(rd_toml2)" direct-server)" != N ]]; then
      log "unsafe: direct-IP off write/readback failed" >&2
      failed=1
    fi
  fi
  # Even if native stop failed, attempt owned durable disables and bootouts.
  # Never interpret one control succeeding as proof that another is off.
  durable_disable_unit "system/${RD_DAEMON_LABEL}" || {
    log "unsafe: daemon durable disable unproved" >&2
    failed=1
  }
  durable_disable_unit "gui/$(id -u)/${RD_AGENT_LABEL}" || {
    log "unsafe: agent durable disable unproved" >&2
    failed=1
  }
  bootout_unit "system/${RD_DAEMON_LABEL}" || {
    log "unsafe: daemon bootout unproved" >&2
    failed=1
  }
  bootout_unit "gui/$(id -u)/${RD_AGENT_LABEL}" || {
    log "unsafe: agent bootout unproved" >&2
    failed=1
  }
  max="${REMOTE_ACCESS_LISTEN_WAIT:-5}"
  i=0
  while :; do
    status="$(off_listener_status)"
    [[ "$status" == absent ]] && break
    if [[ "$i" -ge "$max" ]]; then
      log "unsafe: listener ${status}" >&2
      failed=1
      break
    fi
    sleep 1
    i=$((i + 1))
  done
  # A vendor rewrite after the first native readback must not become a
  # disabled/rollback success, especially with RunAtLoad plists still on disk.
  if [[ -f "$(rd_toml2)" ]] || rustdesk_cask_present || [[ "$(state_get options.tracked)" == true ]]; then
    if ! options_fingerprint >/dev/null \
      || [[ "$(python_read_option "$(rd_toml2)" stop-service)" != Y || "$(python_read_option "$(rd_toml2)" direct-server)" != N ]] \
      || [[ "$(options_fingerprint)" != "$(state_get options.expected)" ]]; then
      log "unsafe: final native off readback changed" >&2
      failed=1
    fi
  fi
  durable_disable_check_only "system/${RD_DAEMON_LABEL}" || {
    log "unsafe: final daemon durable disable unproved" >&2
    failed=1
  }
  durable_disable_check_only "gui/$(id -u)/${RD_AGENT_LABEL}" || {
    log "unsafe: final agent durable disable unproved" >&2
    failed=1
  }
  if [[ "$failed" -ne 0 ]]; then
    state_set --set journal.phase unsafe || true
    log "unsafe: native stop, launchd durable disable/bootout, or listener absence is unproved" >&2
    return 1
  fi
  state_set --set journal.phase off
}

enable_exit_guard() {
  local exit_status="$1"
  if [[ "$exit_status" -ne 0 && "${ENABLE_TRANSACTION:-0}" -eq 1 ]]; then
    if guarded_off; then
      state_set --set intent disabled --set journal.phase steady || true
      log "enable failed; reconciled to guarded off" >&2
    else
      log "unsafe: enable failed and off could not be proved" >&2
    fi
  fi
}

# A failed preflight on an already active installation is not allowed to leave
# an old allowlist listening for a peer that may have been replaced.
revoke_active_on_preflight_failure() {
  if [[ "${DRY_RUN}" -eq 0 && "$(state_get intent)" == enabled ]]; then
    guarded_off || return 1
    state_set --set intent disabled --set journal.phase steady || return 1
  fi
}

cmd_enable() {
  if ! is_darwin; then
    die "enable is macOS-only"
  fi
  if [[ "${DRY_RUN}" -eq 0 && -n "$(state_get journal.phase)" && "$(state_get journal.phase)" != steady ]]; then
    guarded_off || return 1
    state_set --set intent disabled --set journal.phase steady
  fi
  if [[ "$(state_get intent)" == "disabled" && "${DRY_RUN}" -eq 0 ]]; then
    if [[ -f "$(rd_toml2)" && "$(python_read_option "$(rd_toml2)" stop-service)" != "Y" ]]; then
      log "disabled intent lacks native stop-service=Y; refusing enable until repaired"
      return 4
    fi
    log "re-enabling after explicit disable --apply"
  fi
  # Repeated enable is a new transaction, not a harmless preflight: a failed
  # backend install, login, peer lookup or password check must never leave the
  # previous direct-IP listener and allowlist active. Revoke it before doing
  # anything that can fail, and journal the disabled intent before preflight.
  if [[ "${DRY_RUN}" -eq 0 && "$(state_get intent)" == enabled ]]; then
    guarded_off || return 1
    state_set --set intent disabled --set journal.phase steady
  fi
  ensure_tailscale_backend
  if gui_tailscale_present; then
    log "preserving GUI Tailscale; not starting brew services (GUI variant does not run before login)"
  else
    start_tailscale_service
    configure_tailscale_operator
  fi
  if [[ "${DRY_RUN}" -eq 0 && "$(ts_status_line)" != "up" ]]; then
    revoke_active_on_preflight_failure || return 1
    log "tailscale is not logged in. In Terminal: sudo tailscale up"
    log "then: sudo tailscale set --operator=$(id -un)"
    log "then re-run: just remote-access enable --apply"
    exit 4
  fi
  if [[ "${DRY_RUN}" -eq 0 ]]; then
    if ! rustdesk_cask_present; then
      revoke_active_on_preflight_failure || return 1
      log "RustDesk.app missing; run: just remote-access install --apply"
      exit 4
    fi
    local peer_rc=0
    select_peer_ips "${PEER:-}" || peer_rc=$?
    if [[ "$peer_rc" -ne 0 ]]; then
      revoke_active_on_preflight_failure || return 1
      if [[ "$peer_rc" -eq 2 ]]; then
        log "Tailscale peer selection is ambiguous. Re-run with --peer <unique hostname>."
      else
        log "no matching Tailscale peer address found; refusing allow-all"
      fi
      exit 4
    fi
    local saved_id saved_tailnet saved_host
    saved_id="$(state_get peer.id)"
    saved_tailnet="$(state_get peer.tailnet)"
    saved_host="$(state_get peer.hostname)"
    if [[ -n "$saved_host" && (-z "$saved_id" || -z "$saved_tailnet") ]]; then
      revoke_active_on_preflight_failure || return 1
      die "peer identity is unpinned; explicit review/rebind required (no automatic hostname/IP adoption)"
    fi
    if [[ -n "$saved_id" && ("$SELECTED_PEER_ID" != "$saved_id" || "$SELECTED_TAILNET" != "$saved_tailnet" || "$SELECTED_PEER_HOST" != "$saved_host") ]]; then
      revoke_active_on_preflight_failure || return 1
      die "peer identity changed; explicit review/rebind required (no automatic hostname/IP adoption)"
    fi
    if ! password_present; then
      revoke_active_on_preflight_failure || return 1
      open_permission_surfaces
      log "permanent password is not set. In RustDesk: Settings → Security → set a unique permanent password, approval = password only."
      log "then re-run: just remote-access enable --apply"
      return 4
    fi
    ENABLE_TRANSACTION=1
    guarded_off || return 1
    # The native stop and both bootouts were proved before touching direct IP
    # or a vendor plist. Each later step stays in the journal's arming phase.
    state_set --set journal.phase arming
    merge_rustdesk_options
    write_vendor_plists
    state_set --set intent enabled
    option_apply --set stop-service N
    if ! enabled_readback; then
      log "unsafe: enabled readback failed" >&2
      return 1
    fi
    state_set --set journal.phase steady
    ENABLE_TRANSACTION=0
    open_permission_surfaces
    log "enabled. Grant Screen Recording, Accessibility, and Input Monitoring if prompted."
  else
    if gui_tailscale_present; then
      log "dry-run: would preserve GUI Tailscale, merge options, install vendor plists, persist enabled"
    else
      log "dry-run: would start brew tailscale, merge options, install vendor plists, persist enabled"
    fi
    log "dry-run: would not set or rotate a password"
  fi
}

cmd_disable() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would stage native stop, durably disable and bootout owned vendor jobs, prove no listener, persist disabled"
    log "dry-run: would leave Tailscale running"
    return 0
  fi
  guarded_off || return 1
  state_set --set intent disabled --set journal.phase steady
  log "disabled (native stop, owned launchd overrides, both bootouts, all-port listener absence verified). Tailscale was left running."
}

cmd_rollback() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "dry-run: would prove off, remove only fingerprint-owned plists, CAS-restore managed options with direct IP still off"
    return 0
  fi
  guarded_off || return 1
  state_set --set journal.phase rolling-back
  remove_vendor_plists || {
    state_set --set journal.phase unsafe
    return 1
  }
  if [[ "$(state_get options.tracked)" == true ]]; then
    restore_managed_options || {
      state_set --set journal.phase unsafe
      return 1
    }
  fi
  guarded_off || return 1
  if [[ "$(state_get owned.tailscale_started_by_us)" == "true" ]]; then
    log "leaving Tailscale brew service running (shared identity); stop with: sudo brew services stop tailscale"
  fi
  state_set --set intent rolled-back --set journal.phase steady
  log "rollback complete; safe-off sentinel retained. RustDesk.app and Tailscale identity kept."
}

listener_owner_status() {
  local port="$1" records pid command_line exe_records exe_line exe_found found=0
  if ! command -v lsof >/dev/null 2>&1; then
    printf 'unknown\n'
    return 0
  fi
  records="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -Fpc 2>/dev/null)" || {
    printf 'unknown\n'
    return 0
  }
  while IFS= read -r record; do
    [[ "$record" == p* ]] || continue
    pid="${record#p}"
    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
      printf 'unknown\n'
      return 0
    fi
    found=1
    command_line="$(ps -p "$pid" -o command= 2>/dev/null)" || {
      printf 'unknown\n'
      return 0
    }
    case "$command_line" in
      "$RD_BIN --server" | "$RD_BIN --server "* | "$RD_APP/Contents/MacOS/service" | "$RD_APP/Contents/MacOS/service "*) ;;
      *)
        printf 'mismatch\n'
        return 0
        ;;
    esac
    exe_records="$(lsof -nP -a -p "$pid" -d txt -Fn 2>/dev/null)" || {
      printf 'unknown\n'
      return 0
    }
    exe_found=0
    while IFS= read -r exe_line; do
      [[ "$exe_line" == n* ]] || continue
      case "${exe_line#n}" in
        "$RD_BIN" | "$RD_APP/Contents/MacOS/service") exe_found=1 ;;
        *)
          printf 'mismatch\n'
          return 0
          ;;
      esac
    done <<<"$exe_records"
    if [[ "$exe_found" -ne 1 ]]; then
      printf 'unknown\n'
      return 0
    fi
  done <<<"$records"
  if [[ "$found" -eq 1 ]]; then
    printf 'verified\n'
  else
    printf 'unknown\n'
  fi
}

# Return 0 only for a fully owned, configured, observed enabled service.
enabled_readback() {
  local key value expected port white peer_check ts_json backend_state self_online target name override
  if ! lifecycle_hold; then
    log "broken: loaded-job identity is unproved"
    return 1
  fi
  if [[ "$(state_get journal.phase)" != arming && "$(state_get journal.phase)" != steady ]]; then
    log "broken: incomplete lifecycle journal"
    return 1
  fi
  local -a required=(
    'direct-server:Y' 'enable-keyboard:Y' 'enable-clipboard:Y'
    'enable-file-transfer:N' 'enable-tunnel:N' 'enable-terminal:N'
    'allow-remote-config-modification:N' 'enable-record-session:N'
    'enable-audio:Y' 'enable-lan-discovery:N' 'approve-mode:password'
    'verification-method:use-permanent-password' 'stop-service:N'
  )
  options_fingerprint >/dev/null || {
    log "broken: ambiguous native options"
    return 1
  }
  for value in "${required[@]}"; do
    key="${value%%:*}"
    expected="${value#*:}"
    if [[ "$(python_read_option "$(rd_toml2)" "$key")" != "$expected" ]]; then
      log "broken: native ${key} differs from required setting"
      return 1
    fi
  done
  [[ "$(state_get options.tracked)" == true && -z "$(state_get options.next)" && "$(options_fingerprint)" == "$(state_get options.expected)" ]] || {
    log "broken: native options changed outside journal"
    return 1
  }
  port="$(state_get last.port)"
  [[ "$port" =~ ^[0-9]+$ && "$port" -gt 0 && "$port" -le 65535 ]] || {
    log "broken: saved port missing"
    return 1
  }
  [[ "$(python_read_option "$(rd_toml2)" direct-access-port)" == "$port" ]] || {
    log "broken: direct-access-port drift"
    return 1
  }
  white="$(python_read_option "$(rd_toml2)" whitelist)"
  [[ -n "$white" && "$white" != , ]] || {
    log "broken: whitelist unset"
    return 1
  }
  log "access: whitelist configured (addresses not printed)"
  [[ "$(ts_status_line)" == up ]] || {
    log "broken: tailscale-daemon"
    return 1
  }
  ts_json="$(summarize_tailscale_json)"
  backend_state="$(printf '%s\n' "$ts_json" | awk -F= '/^backend=/{print $2; exit}')"
  self_online="$(printf '%s\n' "$ts_json" | awk -F= '/^online=/{print $2; exit}')"
  [[ "$backend_state" == Running ]] || {
    log "broken: tailscale-backend"
    return 1
  }
  [[ "$self_online" == true ]] || {
    log "broken: tailscale-offline"
    return 1
  }
  peer_check="$(check_saved_peer_whitelist "$(state_get peer.id)" "$(state_get peer.tailnet)" "$white" "$(state_get peer.hostname)")" || {
    log "broken: peer-status-unavailable"
    return 1
  }
  [[ -z "$peer_check" ]] || {
    log "broken: ${peer_check}"
    return 1
  }
  password_present || {
    log "broken: permanent password missing"
    return 1
  }
  check_owned_plists || {
    log "broken: vendor plist ownership or fingerprint mismatch"
    return 1
  }
  for target in "system/${RD_DAEMON_LABEL}" "gui/$(id -u)/${RD_AGENT_LABEL}"; do
    run_sudo launchctl print "$target" >/dev/null 2>&1 || {
      log "broken: vendor launchd job not loaded"
      return 1
    }
    name="$(launchd_unit_name "$target")" || return 1
    override="$(launchctl_disabled_status "$target")"
    [[ "$override" == unset || "$override" == enabled ]] \
      && [[ "$(state_get "launchd.${name}.disable_pending")" != true && "$(state_get "launchd.${name}.disabled_by_us")" != true ]] || {
      log "broken: ${name} launchd startup override disabled or unproved"
      return 1
    }
  done
  [[ "$(listener_owner_status "$port")" == verified ]] || {
    log "broken: listener-owner missing or mismatched on ${port}"
    return 1
  }
  log "verified: RustDesk listener on ${port} (local process ownership; not proof of iPhone path)"
}

cmd_doctor() {
  if ! is_darwin; then
    log "status: unsupported"
    return 3
  fi
  DOCTOR_READ_ONLY=1
  print_inventory
  local intent phase status
  intent="$(state_get intent)"
  phase="$(state_get journal.phase)"
  log "configured: intent=${intent:-unset} phase=${phase:-untracked} backend=$(state_get backend)"
  log "permissions: Screen Recording / Accessibility / Input Monitoring remain manual TCC gates"
  log "exposure: a direct-IP listener needs both RustDesk allowlist and tailnet membership"
  log "FileVault: processes are not reachable before unlock"
  if [[ "$intent" == enabled ]]; then
    enabled_readback || return 1
    return 0
  fi
  if [[ "$intent" == disabled || "$intent" == rolled-back ]]; then
    [[ "$phase" == steady ]] || {
      log "unsafe: lifecycle journal incomplete"
      return 1
    }
    if [[ -f "$(rd_toml2)" ]] || rustdesk_cask_present; then
      options_fingerprint >/dev/null || {
        log "unsafe: ambiguous native options"
        return 1
      }
      [[ "$(python_read_option "$(rd_toml2)" stop-service)" == Y && "$(python_read_option "$(rd_toml2)" direct-server)" == N ]] || {
        log "unsafe: native stop/direct-IP not off"
        return 1
      }
    fi
    status="$(off_listener_status)"
    [[ "$status" == absent ]] || {
      log "unsafe: listener ${status}"
      return 1
    }
    bootout_check_only "system/${RD_DAEMON_LABEL}" || {
      log "unsafe: vendor daemon loaded/unknown"
      return 1
    }
    bootout_check_only "gui/$(id -u)/${RD_AGENT_LABEL}" || {
      log "unsafe: vendor agent loaded/unknown"
      return 1
    }
    durable_disable_check_only "system/${RD_DAEMON_LABEL}" || {
      log "unsafe: vendor daemon durable disable unproved"
      return 1
    }
    durable_disable_check_only "gui/$(id -u)/${RD_AGENT_LABEL}" || {
      log "unsafe: vendor agent durable disable unproved"
      return 1
    }
    log "status: disabled-intent honored (off and owned launchd overrides proved)"
    return 0
  fi
  if [[ -n "$phase" && "$phase" != steady ]]; then
    log "unsafe: incomplete lifecycle journal"
    return 1
  fi
  log "pending: $(pending_gates)"
  return 4
}

bootout_check_only() {
  local rc=0
  run_sudo launchctl print "$1" >/dev/null 2>&1 || rc=$?
  [[ "$rc" -eq 113 ]]
}

# The source cannot bind a loaded launchd label to the plist we created or
# exclude privileged writers between a pathname check and removal.
lifecycle_hold() {
  printf '%s\n' 'blocked: source-only lifecycle hold; loaded-job ownership and writer exclusion are unproved. Existing access may still be active; no change was made.' >&2
  return 4 # REMOTE_ACCESS_SOURCE_HOLD
}

main() {
  : "${HOME:?HOME is unset}"
  refuse_secrets
  RD_APP="${REMOTE_ACCESS_RD_APP:-/Applications/RustDesk.app}"
  RD_BIN="${RD_APP}/Contents/MacOS/RustDesk"
  DRY_RUN=0
  APPLY=0
  PEER="${REMOTE_ACCESS_PEER:-}"
  local mode="plan" mode_set=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      -h | --help)
        usage
        return 0
        ;;
    esac
  done
  while [[ $# -gt 0 ]]; do
    case "$1" in
      plan | install | enable | doctor | disable | rollback)
        [[ "$mode_set" -eq 0 ]] || die "multiple subcommands are not allowed"
        mode="$1"
        mode_set=1
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --apply)
        APPLY=1
        shift
        ;;
      --peer)
        [[ $# -ge 2 ]] || die "--peer requires a hostname"
        PEER="$2"
        shift 2
        ;;
      --password | -p)
        die "password flags are refused; use the RustDesk Security UI"
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
  if [[ "$DRY_RUN" -eq 1 && "$APPLY" -eq 1 ]]; then
    printf '%s\n' '--dry-run and --apply cannot be used together.' >&2
    usage >&2
    exit 2
  fi
  case "$mode" in
    install | enable | disable | rollback)
      if [[ "$APPLY" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
        DRY_RUN=1
        log "mutating command defaulted to --dry-run (pass --apply to change the Mac)"
      fi
      ;;
  esac
  if [[ "$APPLY" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
    case "$mode" in
      enable | disable | rollback) lifecycle_hold || return $? ;;
    esac
  fi
  if [[ "$mode" != "plan" && "$mode" != "doctor" && "$DRY_RUN" -eq 0 ]]; then
    acquire_lock
    trap 'enable_exit_guard "$?"; release_lock' EXIT
    state_get journal.phase >/dev/null || die "unsafe: state journal cannot be read; no mutation attempted"
  fi
  if ! is_darwin && [[ "$mode" != "plan" && "$mode" != "doctor" ]]; then
    log "unsupported on $(uname_s)"
    exit 3
  fi
  case "$mode" in
    plan) cmd_plan ;;
    install) cmd_install ;;
    enable) cmd_enable ;;
    doctor) cmd_doctor ;;
    disable) cmd_disable ;;
    rollback) cmd_rollback ;;
    *) die "unknown mode: $mode" ;;
  esac
}

main "$@"
