#!/usr/bin/env bash
# Nightly Kopia CLI snapshot runner (04:00 LaunchAgent). No GUI.
set -euo pipefail

if [[ -n "${KOPIA_NIGHTLY_TEST_BIN:-}" ]]; then
  export PATH="${KOPIA_NIGHTLY_TEST_BIN}:/opt/homebrew/bin:/usr/bin:/bin"
  GTIMEOUT="${KOPIA_NIGHTLY_TEST_BIN}/gtimeout"
else
  export PATH="/opt/homebrew/bin:/usr/bin:/bin${PATH:+:$PATH}"
  GTIMEOUT="/opt/homebrew/bin/gtimeout"
fi

RUN_TIMEOUT_SECONDS=43140
RUN_KILL_GRACE_SECONDS=60

LABEL_NIGHTLY="com.wyattowalsh.kopia-nightly"
LABEL_LOGIN="com.kopia.kopiaui.login"
LABEL_UI="KopiaUI"
PLIST_NAME="com.wyattowalsh.kopia-nightly.plist"
DEST_RUNNER="${HOME}/.local/bin/kopia-nightly"
LOG_DIR="${HOME}/Library/Logs/kopia"
TMP_DIR="${HOME}/Library/Logs/kopia/tmp"
REPO_RUNNER_REL="rig/home/dot_local/bin/executable_kopia-nightly"

RUN_ACTIVE=0
RUN_FINALIZED=0
RUN_OPERATIONAL_FAILED=0
RUN_MAINTENANCE_WARNING=0
RUN_NOTIFICATION_SENT=0
RUN_SIGNAL_STATUS=0
RUN_TEMP_FILE=""

log() {
  printf '[kopia-nightly] %s\n' "$*"
}

die() {
  if [[ "$RUN_ACTIVE" -eq 1 ]]; then
    RUN_OPERATIONAL_FAILED=1
  fi
  log "error: $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: kopia-nightly [--dry-run]
       kopia-nightly install [--dry-run]
       kopia-nightly doctor [--policies]

  (default)   Snapshot the 04:00 source list, then disable KopiaUI login agents.
  --dry-run   Print plan / sources; no repository writes; no launchctl mutations.
  install     Sync dest runner (if KOPIA_NIGHTLY_REPO is set), disable UI login
              agents, bootstrap the nightly LaunchAgent.
  doctor      Check launchd-like repo access, dest/source hash, login-agent state.
  --policies  With doctor: two-way 04:00 drift vs live policies (network).
USAGE
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

gui_domain() {
  printf 'gui/%s' "$(id -u)"
}

label_path() {
  printf '%s/%s' "$(gui_domain)" "$1"
}

agent_loaded() {
  launchctl print "$(label_path "$1")" >/dev/null 2>&1
}

kopia_ui_running() {
  pgrep -x KopiaUI >/dev/null 2>&1 && return 0
  pgrep -f '/Applications/KopiaUI.app/Contents/MacOS/KopiaUI' >/dev/null 2>&1
}

ensure_kopiaui_quit() {
  if ! kopia_ui_running; then
    return 0
  fi
  log "quitting KopiaUI to avoid repository lock"
  osascript -e 'tell application "KopiaUI" to quit' >/dev/null 2>&1 || true
  local waited=0
  while [[ "$waited" -lt 15 ]]; do
    if ! kopia_ui_running; then
      log "KopiaUI quit"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  die "KopiaUI still running after quit; aborting to avoid repository lock"
}

disable_label() {
  local label="$1"
  local status=0
  if agent_loaded "$label"; then
    if ! launchctl bootout "$(label_path "$label")" >/dev/null 2>&1; then
      status=1
    fi
  fi
  if ! launchctl disable "$(label_path "$label")" >/dev/null 2>&1; then
    status=1
  fi
  return "$status"
}

ensure_login_disabled() {
  local status=0
  disable_label "$LABEL_LOGIN" || status=1
  disable_label "$LABEL_UI" || status=1
  return "$status"
}

print_login_item_hint() {
  cat <<'HINT'
If the nightly agent is not loaded, allow it under:
  System Settings → General → Login Items & Extensions → Allow in the Background
Then re-run: kopia-nightly install
HINT
}

repo_runner_path() {
  if [[ -n "${KOPIA_NIGHTLY_REPO:-}" && -f "${KOPIA_NIGHTLY_REPO}/${REPO_RUNNER_REL}" ]]; then
    printf '%s\n' "${KOPIA_NIGHTLY_REPO}/${REPO_RUNNER_REL}"
    return 0
  fi
  return 1
}

source_list() {
  printf '%s\n' \
    "${HOME}/.bash_profile" \
    "${HOME}/.bashrc" \
    "${HOME}/.codex/memories" \
    "${HOME}/.gitconfig" \
    "${HOME}/.github" \
    "${HOME}/.gitignore" \
    "${HOME}/.zshrc" \
    "${HOME}/Documents" \
    "${HOME}/Movies" \
    "${HOME}/Music" \
    "${HOME}/Pictures" \
    "${HOME}/Public" \
    "${HOME}/dev" \
    "${HOME}/src"
}

file_sha256() {
  shasum -a 256 "$1" | awk '{print $1}'
}

wait_repo_ready() {
  local attempt=1
  local max_attempts=8
  local -a delays=(5 10 20 30 30 30 30)
  local rc=0

  while [[ "$attempt" -le "$max_attempts" ]]; do
    log "repository status attempt ${attempt}/${max_attempts}"
    set +e
    "$GTIMEOUT" --signal=TERM --kill-after=5s 30s kopia repository status >/dev/null 2>&1
    rc=$?
    set -e
    if [[ "$rc" -eq 0 ]]; then
      log "repository status: ok"
      return 0
    fi
    log "repository status failed rc=${rc}"
    if [[ "$attempt" -eq "$max_attempts" ]]; then
      break
    fi
    local delay="${delays[$((attempt - 1))]}"
    log "retrying repository status in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1))
  done

  die "repository unreachable after ${max_attempts} attempts; check rclone remote and network"
}

run_snapshot_loop() {
  local ok=0
  local skip=0
  local fail=0
  local src
  local rc=0
  local attempt
  local snap_log
  local -a create_opts

  # launchd/non-tty: --progress floods logs; XPC_SERVICE_NAME marks LaunchAgent.
  create_opts=(--no-fail-fast)
  if [[ -t 1 && -z "${XPC_SERVICE_NAME:-}" ]]; then
    create_opts=(--progress --no-fail-fast)
  fi

  while IFS= read -r src; do
    if [[ ! -e "$src" ]]; then
      log "skip missing: $src"
      skip=$((skip + 1))
      continue
    fi

    snap_log="$(mktemp "${TMP_DIR}/kopia-nightly.XXXXXX")"
    RUN_TEMP_FILE="$snap_log"
    attempt=1
    while true; do
      if [[ "$attempt" -eq 1 ]]; then
        log "snapshot: $src"
      else
        log "snapshot retry ${attempt}/3: $src"
      fi
      set +e
      kopia snapshot create "${create_opts[@]}" "$src" 2>&1 | tee "${snap_log}"
      rc=${PIPESTATUS[0]}
      set -e
      if [[ "$rc" -eq 0 ]]; then
        ok=$((ok + 1))
        break
      fi
      if [[ "$attempt" -lt 3 ]] && grep -qi rclone "${snap_log}" && grep -qi timeout "${snap_log}"; then
        log "rclone start timeout rc=${rc}; retrying $src"
        attempt=$((attempt + 1))
        continue
      fi
      log "snapshot failed rc=${rc}: $src"
      fail=$((fail + 1))
      break
    done
    rm -f "${snap_log}"
    RUN_TEMP_FILE=""
  done < <(source_list)

  log "summary ok=${ok} skip=${skip} fail=${fail}"
  if [[ "$fail" -gt 0 ]]; then
    return 1
  fi
  return 0
}

initialize_run_state() {
  RUN_ACTIVE=1
  RUN_FINALIZED=0
  RUN_OPERATIONAL_FAILED=0
  RUN_MAINTENANCE_WARNING=0
  RUN_NOTIFICATION_SENT=0
  RUN_SIGNAL_STATUS=0
  RUN_TEMP_FILE=""
}

emit_outcome_notification() {
  local outcome="$1"
  local script=""

  if [[ "$RUN_NOTIFICATION_SENT" -eq 1 ]]; then
    return 0
  fi
  RUN_NOTIFICATION_SENT=1

  case "$outcome" in
    warning)
      script='display notification "Kopia nightly maintenance needs attention" with title "kopia-nightly"'
      ;;
    failure)
      script='display notification "Kopia nightly failed; check the local log" with title "kopia-nightly"'
      ;;
    *)
      return 0
      ;;
  esac

  if [[ ! -x "$GTIMEOUT" ]] || ! command -v osascript >/dev/null 2>&1; then
    return 0
  fi
  "$GTIMEOUT" --signal=TERM --kill-after=2s 10s osascript -e "$script" >/dev/null 2>&1 || true
}

handle_signal() {
  local status="$1"
  RUN_SIGNAL_STATUS="$status"
  RUN_OPERATIONAL_FAILED=1
  log "caught signal; exiting ${status}" >&2
  exit "$status"
}

finalize_run() {
  local entry_status="$1"
  local final_status="$entry_status"
  local cleanup_failed=0

  trap - EXIT TERM INT
  if [[ "$RUN_FINALIZED" -eq 1 ]]; then
    exit "$final_status"
  fi
  RUN_FINALIZED=1

  # Re-disable GUI login agents before any other cleanup.
  if ! ensure_login_disabled; then
    cleanup_failed=1
    log "error: failed to disable one or more KopiaUI login agents during finalization" >&2
  fi

  if [[ -n "$RUN_TEMP_FILE" && "$RUN_TEMP_FILE" == "${TMP_DIR}/kopia-nightly."* ]]; then
    if ! rm -f "$RUN_TEMP_FILE"; then
      cleanup_failed=1
      log "error: failed to remove temporary snapshot log" >&2
    fi
    RUN_TEMP_FILE=""
  fi

  if [[ "$RUN_SIGNAL_STATUS" -ne 0 ]]; then
    final_status="$RUN_SIGNAL_STATUS"
  elif [[ "$entry_status" -ne 0 || "$RUN_OPERATIONAL_FAILED" -ne 0 || "$cleanup_failed" -ne 0 ]]; then
    if [[ "$entry_status" -eq 0 ]]; then
      final_status=1
    fi
  else
    final_status=0
  fi

  if [[ "$final_status" -ne 0 ]]; then
    emit_outcome_notification failure
  elif [[ "$RUN_MAINTENANCE_WARNING" -ne 0 ]]; then
    emit_outcome_notification warning
  fi

  exit "$final_status"
}

test_signal_barrier() {
  if [[ "${KOPIA_NIGHTLY_TEST_SIGNAL_WAIT:-0}" -ne 1 ]]; then
    return 0
  fi
  : "${KOPIA_NIGHTLY_TEST_STATE:?test signal state is unset}"
  : >"${KOPIA_NIGHTLY_TEST_STATE}/signal-ready"
  while [[ ! -f "${KOPIA_NIGHTLY_TEST_STATE}/signal-release" ]]; do
    /bin/sleep 1
  done
}

cmd_run_dry() {
  require_cmd kopia
  require_cmd rclone

  local ok=0
  local skip=0
  local src

  log "dry-run: would require kopia and rclone (present)"
  while IFS= read -r src; do
    if [[ -e "$src" ]]; then
      log "would snapshot: $src"
      ok=$((ok + 1))
    else
      log "would skip missing: $src"
      skip=$((skip + 1))
    fi
  done < <(source_list)
  log "summary ok=${ok} skip=${skip} fail=0 (dry-run)"
}

cmd_bounded_run() {
  initialize_run_state
  trap 'finalize_run "$?"' EXIT
  trap 'handle_signal 143' TERM
  trap 'handle_signal 130' INT

  require_cmd kopia
  require_cmd rclone
  require_cmd launchctl
  require_cmd flock
  if [[ ! -x "$GTIMEOUT" ]]; then
    die "missing executable: $GTIMEOUT"
  fi

  mkdir -p "${TMP_DIR}"
  exec 9>"${LOG_DIR}/nightly.lock"
  if ! flock -n 9; then
    die "another nightly run holds ${LOG_DIR}/nightly.lock"
  fi

  if ! ensure_login_disabled; then
    die "failed to disable one or more KopiaUI login agents"
  fi

  ensure_kopiaui_quit

  if command -v caffeinate >/dev/null 2>&1; then
    caffeinate -i -w "$$" >/dev/null 2>&1 &
    log "holding idle sleep (caffeinate -i -w $$)"
  else
    log "caffeinate missing; snapshots may sleep mid-upload"
  fi

  test_signal_barrier
  wait_repo_ready

  local snap_rc=0
  local maint_rc=0
  set +e
  run_snapshot_loop
  snap_rc=$?
  set -e

  set +e
  kopia maintenance run --full
  maint_rc=$?
  set -e
  log "maintenance run --full rc=${maint_rc}"
  if [[ "$maint_rc" -ne 0 ]]; then
    log "warning: maintenance failed (not failing job)"
    RUN_MAINTENANCE_WARNING=1
  fi

  if [[ "$snap_rc" -ne 0 ]]; then
    RUN_OPERATIONAL_FAILED=1
  fi

  return "$snap_rc"
}

cmd_run() {
  local dry_run="$1"
  if [[ "$dry_run" -eq 1 ]]; then
    cmd_run_dry
    return
  fi
  if [[ ! -x "$GTIMEOUT" ]]; then
    die "missing executable: $GTIMEOUT"
  fi
  exec "$GTIMEOUT" --verbose --signal=TERM --kill-after="${RUN_KILL_GRACE_SECONDS}s" "${RUN_TIMEOUT_SECONDS}s" "$0" __bounded-run
}

cmd_install() {
  local dry_run="$1"
  local dest="${HOME}/Library/LaunchAgents/${PLIST_NAME}"
  local src_runner=""

  if src_runner="$(repo_runner_path)"; then
    if [[ "$dry_run" -eq 1 ]]; then
      log "dry-run: would /bin/cp -f ${src_runner} ${DEST_RUNNER}"
    else
      mkdir -p "$(dirname "${DEST_RUNNER}")"
      /bin/cp -f "${src_runner}" "${DEST_RUNNER}"
      /bin/chmod +x "${DEST_RUNNER}"
      log "synced dest runner from repo source"
    fi
  elif [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: KOPIA_NIGHTLY_REPO unset or source missing; would skip dest runner sync"
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would disable ${LABEL_LOGIN} and ${LABEL_UI}"
    log "dry-run: would bootstrap ${LABEL_NIGHTLY} from ${dest}"
    if [[ ! -f "$dest" ]]; then
      log "dry-run: dest plist missing — apply Chezmoi home first"
    fi
    return 0
  fi

  require_cmd launchctl
  if ! ensure_login_disabled; then
    die "failed to disable one or more KopiaUI login agents"
  fi

  if [[ ! -f "$dest" ]]; then
    die "dest plist missing (${dest}); apply Chezmoi from rig/home first"
  fi

  mkdir -p "${TMP_DIR}"
  mkdir -p "${HOME}/Library/LaunchAgents"

  if agent_loaded "$LABEL_NIGHTLY"; then
    launchctl bootout "$(label_path "$LABEL_NIGHTLY")" >/dev/null 2>&1 || true
  fi
  if ! launchctl bootstrap "$(gui_domain)" "$dest"; then
    log "bootstrap failed for ${LABEL_NIGHTLY}"
    print_login_item_hint
    return 1
  fi
  launchctl enable "$(label_path "$LABEL_NIGHTLY")" >/dev/null 2>&1 || true

  if agent_loaded "$LABEL_NIGHTLY"; then
    log "loaded ${LABEL_NIGHTLY} (RunAtLoad=false; calendar 04:00)"
  else
    log "${LABEL_NIGHTLY} not visible to launchctl after bootstrap"
    print_login_item_hint
    return 1
  fi
  return 0
}

cmd_doctor() {
  local check_policies="$1"
  local dest="${HOME}/Library/LaunchAgents/${PLIST_NAME}"
  local status=0
  local src_runner=""

  require_cmd kopia

  if env -i HOME="${HOME}" PATH="/opt/homebrew/bin:/usr/bin:/bin" \
    kopia repository status >/dev/null 2>&1; then
    log "repository status: ok (launchd-like env)"
  else
    log "repository status: FAIL (launchd-like env cannot see repo)"
    status=1
  fi

  if kopia_ui_running; then
    log "KopiaUI: running (nightly run will quit it)"
  else
    log "KopiaUI: not running"
  fi

  if agent_loaded "$LABEL_LOGIN"; then
    log "login agent ${LABEL_LOGIN}: LOADED (should be disabled)"
    status=1
  else
    log "login agent ${LABEL_LOGIN}: not loaded"
  fi
  if agent_loaded "$LABEL_UI"; then
    log "login agent ${LABEL_UI}: LOADED (should be disabled)"
    status=1
  else
    log "login agent ${LABEL_UI}: not loaded"
  fi

  if [[ -f "$dest" ]]; then
    log "nightly plist: present"
  else
    log "nightly plist: missing"
    status=1
  fi
  if agent_loaded "$LABEL_NIGHTLY"; then
    log "nightly agent ${LABEL_NIGHTLY}: loaded"
  else
    log "nightly agent ${LABEL_NIGHTLY}: not loaded"
    print_login_item_hint
    status=1
  fi

  if [[ -f "${DEST_RUNNER}" ]] && src_runner="$(repo_runner_path)"; then
    local dest_hash src_hash
    dest_hash="$(file_sha256 "${DEST_RUNNER}")"
    src_hash="$(file_sha256 "${src_runner}")"
    if [[ "${dest_hash}" == "${src_hash}" ]]; then
      log "dest runner hash: match"
    else
      log "dest runner hash: MISMATCH (run just kopia-nightly-install)"
      status=1
    fi
  elif [[ -f "${DEST_RUNNER}" ]]; then
    log "dest runner present (no KOPIA_NIGHTLY_REPO source to compare)"
  fi

  if [[ "$check_policies" -eq 1 ]]; then
    doctor_policies || status=1
  fi

  return "$status"
}

doctor_policies() {
  require_cmd python3
  log "diffing script list against live 04:00 policies (one policy list --json)"
  local listed json_tmp
  listed="$(source_list)"
  json_tmp="$(mktemp /tmp/kopia-nightly-policies.XXXXXX)"
  if ! kopia policy list --json >"${json_tmp}"; then
    rm -f "${json_tmp}"
    die "kopia policy list --json failed"
  fi
  set +e
  LISTED_SOURCES="${listed}" HOME="${HOME}" python3 - "${json_tmp}" <<'PY'
import json
import os
import sys

home = os.environ["HOME"].rstrip("/")
listed = [line for line in os.environ.get("LISTED_SOURCES", "").splitlines() if line]
listed_set = set(listed)

def is_0400(sched):
    if not isinstance(sched, dict):
        return False
    tod = sched.get("timeOfDay") or sched.get("timesOfDay") or []
    if not isinstance(tod, list):
        return False
    for entry in tod:
        if not isinstance(entry, dict):
            continue
        if int(entry.get("hour", -1)) == 4 and int(entry.get("min", -1)) == 0:
            return True
    return False

def target_path(target):
    if isinstance(target, dict):
        return (target.get("path") or "").rstrip("/")
    if isinstance(target, str) and ":" in target:
        return target.rsplit(":", 1)[-1].rstrip("/")
    return ""

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        policies = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    print(f"[kopia-nightly] policy list json: {exc}", file=sys.stderr)
    sys.exit(1)

if not isinstance(policies, list):
    print("[kopia-nightly] policy list json: expected a list", file=sys.stderr)
    sys.exit(1)

live_0400 = set()
for policy in policies:
    path = target_path(policy.get("target"))
    if not path:
        continue
    if is_0400(policy.get("scheduling") or {}):
        live_0400.add(path)

drift = 0
for path in listed:
    if path in live_0400:
        print(f"[kopia-nightly] policy 04:00 ok: {path}")
    else:
        print(f"[kopia-nightly] policy 04:00 missing or unread: {path}")
        drift = 1

for path in sorted(live_0400 - listed_set):
    if path == home:
        print(f"[kopia-nightly] note: {path} itself has a 04:00 policy but is intentionally not snapshotted")
        continue
    print(f"[kopia-nightly] extra 04:00 source not in script list: {path}")
    drift = 1

sys.exit(drift)
PY
  local rc=$?
  set -e
  rm -f "${json_tmp}"
  return "$rc"
}

main() {
  : "${HOME:?HOME is unset}"

  local dry_run=0
  local mode="run"
  local policies=0
  local arg

  for arg in "$@"; do
    case "$arg" in
      -h | --help)
        usage
        return 0
        ;;
    esac
  done

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --policies)
        policies=1
        shift
        ;;
      install)
        mode="install"
        shift
        ;;
      doctor)
        mode="doctor"
        shift
        ;;
      __bounded-run)
        mode="bounded-run"
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done

  case "$mode" in
    run)
      cmd_run "$dry_run"
      ;;
    install)
      cmd_install "$dry_run"
      ;;
    doctor)
      cmd_doctor "$policies"
      ;;
    bounded-run)
      if [[ "$dry_run" -ne 0 || "$policies" -ne 0 ]]; then
        die "private bounded mode does not accept public options"
      fi
      cmd_bounded_run
      ;;
    *)
      die "unknown mode: $mode"
      ;;
  esac
}

main "$@"
