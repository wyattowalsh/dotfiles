#!/usr/bin/env bash
# Nightly Kopia CLI snapshot runner (04:00 LaunchAgent). No GUI.
set -euo pipefail
umask 077

export PATH="/opt/homebrew/bin:/usr/bin:/bin${PATH:+:$PATH}"

LABEL_NIGHTLY="com.wyattowalsh.kopia-nightly"
LABEL_LOGIN="com.kopia.kopiaui.login"
LABEL_UI="KopiaUI"
PLIST_NAME="com.wyattowalsh.kopia-nightly.plist"
DEST_RUNNER="${HOME}/.local/bin/kopia-nightly"
LOG_DIR="${HOME}/Library/Logs/kopia"
TMP_DIR="${HOME}/Library/Logs/kopia/tmp"
REPO_RUNNER_REL="rig/home/dot_local/bin/executable_kopia-nightly"
LAUNCHD_ONLY_ARCHIVE="${HOME}/.local/share/mba-phone-usb-successor/archive-20261025-v123"
RUN_FINALIZED=0
RUN_MAINTENANCE_WARNING=0
RUN_NOTIFICATION_SENT=0
RUN_SIGNAL_STATUS=0
RUN_TEMP_FILE=""
RUN_BOUNDED=0
caffeine_pid=""

log() {
  printf '[kopia-nightly] %s\n' "$*"
}

die() {
  log "error: $*" >&2
  exit 1
}

is_mba_role() {
  local native_os native_host native_user native_uid
  native_os="$(uname -s)" || return 2
  [[ "$native_os" == Darwin ]] || return 1
  native_host="$(hostname -s)" || return 2
  [[ "$native_host" == MacBookAir ]] || return 1
  native_user="$(id -un)" || return 2
  native_uid="$(id -u)" || return 2
  [[ "${native_user}:${native_uid}" == wyattwalsh:501 ]]
}

guard_nightly_role() {
  local role_status=0
  is_mba_role || role_status=$?
  case "$role_status" in
    0) die "the MBA uses its native KopiaUI scheduler; Nightly is disabled for this host role" ;;
    1) return 0 ;;
    *) die "cannot establish the native backup host role" ;;
  esac
}

usage() {
  cat <<'USAGE'
Usage: kopia-nightly [--dry-run]
       kopia-nightly install [--dry-run]
       kopia-nightly doctor [--policies]

  (default)   Snapshot the 04:00 source list and run full maintenance within
              one wall-clock cap, then disable KopiaUI login agents.
  --dry-run   Print plan / sources; no repository writes; no launchctl mutations.
  install     Sync dest runner (if KOPIA_NIGHTLY_REPO is set), disable UI login
              agents, bootstrap the nightly LaunchAgent.
  doctor      Inspect private runtime paths, bounded launchd-like repo access,
              dest/source hash and login-agent state; never repair or start jobs.
  --policies  With doctor: two-way 04:00 drift vs live policies (network).

  KOPIA_NIGHTLY_TIMEOUT_SEC  snapshot/maintenance cap in seconds (default 43200).
USAGE
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

runtime_path_mode() {
  local mode
  if mode="$(stat -f '%Lp' "$1" 2>/dev/null)"; then
    printf '%s\n' "$mode"
  else
    stat -c '%a' "$1" 2>/dev/null
  fi
}

# Doctor only inspects. Run/install create missing private paths, never chmod
# existing ones or follow a symlink. Install checks before launchd opens its logs.
runtime_paths() {
  local create_missing="$1"
  local path mode
  if [[ -L "${HOME}" || ! -d "${HOME}" || ! -O "${HOME}" ]]; then
    log "runtime paths: FAIL (HOME must be an owned, non-symlink directory)" >&2
    return 1
  fi
  for path in "${HOME}" "${HOME}/Library" "${HOME}/Library/Logs" "${LOG_DIR}" "${TMP_DIR}"; do
    if [[ -L "$path" ]]; then
      log "runtime paths: FAIL (symlink directory: $path)" >&2
      return 1
    fi
    if [[ ! -e "$path" && "$create_missing" -eq 1 ]]; then
      if ! mkdir -m 700 "$path"; then
        log "runtime paths: FAIL (cannot create directory: $path)" >&2
        return 1
      fi
    fi
    if [[ ! -d "$path" || ! -O "$path" || ! -r "$path" || ! -w "$path" || ! -x "$path" ]]; then
      log "runtime paths: FAIL (missing, unowned or inaccessible directory: $path)" >&2
      return 1
    fi
    if ! mode="$(runtime_path_mode "$path")" || [[ ! "$mode" =~ ^[0-7]{3,4}$ ]]; then
      log "runtime paths: FAIL (cannot read directory mode: $path)" >&2
      return 1
    fi
    if (((8#$mode & 0022) != 0)); then
      log "runtime paths: FAIL (group/other-writable directory: $path)" >&2
      return 1
    fi
    case "$path" in
      "${LOG_DIR}" | "${TMP_DIR}")
        if [[ "$mode" != 700 ]]; then
          log "runtime paths: FAIL (directory must have mode 0700: $path)" >&2
          return 1
        fi
        ;;
    esac
  done
  for path in "${LOG_DIR}/nightly.lock" "${LOG_DIR}/nightly.out.log" "${LOG_DIR}/nightly.err.log"; do
    if [[ -L "$path" ]]; then
      log "runtime paths: FAIL (symlink file: $path)" >&2
      return 1
    fi
    if [[ ! -e "$path" && "$create_missing" -eq 1 ]]; then
      if ! (
        set -o noclobber
        : >"$path"
      ); then
        log "runtime paths: FAIL (cannot create file: $path)" >&2
        return 1
      fi
    fi
    if [[ ! -f "$path" || ! -O "$path" || ! -r "$path" || ! -w "$path" ]]; then
      log "runtime paths: FAIL (missing, unowned or inaccessible file: $path)" >&2
      return 1
    fi
    if ! mode="$(runtime_path_mode "$path")" || [[ "$mode" != 600 ]]; then
      log "runtime paths: FAIL (file must have mode 0600: $path)" >&2
      return 1
    fi
  done
  log "runtime paths: ok (owned, non-symlink entries; mode bits 0700/0600)"
}

gui_domain() {
  printf 'gui/%s' "$(id -u)"
}

label_path() {
  printf '%s/%s' "$(gui_domain)" "$1"
}

agent_loaded() {
  launchctl print "$(label_path "$1")" >/dev/null 2>&1
}

kopia_ui_running() {
  pgrep -x KopiaUI >/dev/null 2>&1 && return 0
  pgrep -f '/Applications/KopiaUI.app/Contents/MacOS/KopiaUI' >/dev/null 2>&1
}

ensure_kopiaui_quit() {
  if ! kopia_ui_running; then
    return 0
  fi
  log "quitting KopiaUI to avoid repository lock"
  osascript -e 'tell application "KopiaUI" to quit' >/dev/null 2>&1 || true
  local waited=0
  while [[ "$waited" -lt 15 ]]; do
    if ! kopia_ui_running; then
      log "KopiaUI quit"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  die "KopiaUI still running after quit; aborting to avoid repository lock"
}

disable_label() {
  local label="$1"
  local status=0
  if agent_loaded "$label"; then
    launchctl bootout "$(label_path "$label")" >/dev/null 2>&1 || status=1
  fi
  launchctl disable "$(label_path "$label")" >/dev/null 2>&1 || status=1
  return "$status"
}

ensure_login_disabled() {
  local status=0
  disable_label "$LABEL_LOGIN" || status=1
  disable_label "$LABEL_UI" || status=1
  return "$status"
}

print_login_item_hint() {
  cat <<'HINT'
If the nightly agent is not loaded, allow it under:
  System Settings → General → Login Items & Extensions → Allow in the Background
Only after reviewing scheduler ownership and obtaining install approval,
re-run: kopia-nightly install
HINT
}

repo_runner_path() {
  if [[ -n "${KOPIA_NIGHTLY_REPO:-}" && -f "${KOPIA_NIGHTLY_REPO}/${REPO_RUNNER_REL}" ]]; then
    printf '%s\n' "${KOPIA_NIGHTLY_REPO}/${REPO_RUNNER_REL}"
    return 0
  fi
  return 1
}

source_list() {
  printf '%s\n' \
    "${HOME}/.bash_profile" \
    "${HOME}/.bashrc" \
    "${HOME}/.codex/memories" \
    "$LAUNCHD_ONLY_ARCHIVE" \
    "${HOME}/.gitconfig" \
    "${HOME}/.github" \
    "${HOME}/.gitignore" \
    "${HOME}/.zshrc" \
    "${HOME}/Documents" \
    "${HOME}/Movies" \
    "${HOME}/Music" \
    "${HOME}/Pictures" \
    "${HOME}/Public" \
    "${HOME}/dev" \
    "${HOME}/src"
}

file_sha256() {
  shasum -a 256 "$1" | awk '{print $1}'
}

# launchd TimeOut is unimplemented; enforce the cap in this runner.
snapshot_timeout_sec() {
  local raw="${KOPIA_NIGHTLY_TIMEOUT_SEC:-43200}"
  if [[ ! "$raw" =~ ^[1-9][0-9]*$ ]]; then
    die "KOPIA_NIGHTLY_TIMEOUT_SEC must be a positive integer (got: ${raw})"
  fi
  printf '%s\n' "$raw"
}

resolve_timeout_bin() {
  if command -v timeout >/dev/null 2>&1; then
    printf '%s\n' timeout
    return 0
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    printf '%s\n' gtimeout
    return 0
  fi
  return 1
}

# Prefer GNU timeout; Homebrew coreutils ships gtimeout. `command timeout`
# bypasses a shell alias (zshrc maps timeout → gtimeout).
run_timeout_with_grace() {
  local grace="$1" sec="$2"
  shift 2
  local -a timeout_opts=(--signal=TERM --kill-after="$grace")
  # Keep nested timers in the outer run's process group so its TERM/KILL also
  # reaches their descendants. Doctor retains its own bounded process group.
  if [[ "$RUN_BOUNDED" -eq 1 ]]; then
    timeout_opts+=(--foreground)
  fi
  if command -v timeout >/dev/null 2>&1; then
    command timeout "${timeout_opts[@]}" "$sec" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    command gtimeout "${timeout_opts[@]}" "$sec" "$@"
  else
    die "missing timeout/gtimeout (coreutils) for ${sec}s wall-clock cap"
  fi
}

run_timeout() {
  run_timeout_with_grace 60 "$@"
}

wait_repo_ready() {
  local timeout_sec="$1" start="$2"
  local attempt=1 max_attempts=8 rc now remaining probe_cap delay
  local -a delays=(5 10 20 30 30 30 30)
  while [[ "$attempt" -le "$max_attempts" ]]; do
    now="$(date +%s)"
    remaining=$((timeout_sec - (now - start)))
    if [[ "$remaining" -le 0 ]]; then
      log "repository readiness wall-clock cap reached (${timeout_sec}s)"
      return 1
    fi
    probe_cap=125
    [[ "$remaining" -ge "$probe_cap" ]] || probe_cap="$remaining"
    log "repository status attempt ${attempt}/${max_attempts}"
    if run_timeout_with_grace 5 "$probe_cap" kopia repository status >/dev/null 2>&1; then
      log "repository status: ok"
      return 0
    else
      rc=$?
    fi
    log "repository status failed rc=${rc} (raw diagnostics suppressed)"
    if [[ "$attempt" -eq "$max_attempts" ]]; then
      break
    fi
    now="$(date +%s)"
    remaining=$((timeout_sec - (now - start)))
    if [[ "$remaining" -le 0 ]]; then
      log "repository readiness wall-clock cap reached (${timeout_sec}s)"
      return 1
    fi
    delay="${delays[$((attempt - 1))]}"
    [[ "$remaining" -ge "$delay" ]] || delay="$remaining"
    log "retrying repository status in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1))
  done
  log "repository unreachable after ${max_attempts} attempts; check rclone remote and network" >&2
  return 1
}

is_rclone_startup_timeout() {
  # Kopia v0.23.1 repo/open.go + repo/blob/rclone/rclone_storage.go.
  # Match the native repository-open diagnostic, never words in source paths.
  grep -Eq '^ERROR[[:space:]]+failed to open repository: cannot open storage: unable to start rclone: timed out waiting for rclone to start[[:space:]]*$' "$1"
}

run_snapshot_loop() {
  local timeout_sec="$1" start="$2"
  local ok=0
  local skip=0
  local fail=0
  local src
  local rc=0
  local now remaining attempt
  local -a create_opts=(--fail-fast)
  if [[ -t 1 && -z "${XPC_SERVICE_NAME:-}" ]]; then
    create_opts=(--progress --fail-fast)
  fi
  while IFS= read -r src; do
    now="$(date +%s)"
    remaining=$((timeout_sec - (now - start)))
    if [[ "$remaining" -le 0 ]]; then
      log "snapshot wall-clock cap reached (${timeout_sec}s)"
      fail=$((fail + 1))
      log "summary ok=${ok} skip=${skip} fail=${fail}"
      return 1
    fi
    if [[ ! -e "$src" ]]; then
      log "skip missing: $src"
      skip=$((skip + 1))
      continue
    fi
    RUN_TEMP_FILE="$(mktemp "${TMP_DIR}/kopia-nightly.XXXXXX")" || return 1
    attempt=1
    while true; do
      now="$(date +%s)"
      remaining=$((timeout_sec - (now - start)))
      if [[ "$remaining" -le 0 ]]; then
        log "snapshot wall-clock cap reached (${timeout_sec}s)"
        fail=$((fail + 1))
        log "summary ok=${ok} skip=${skip} fail=${fail}"
        return 1
      fi
      if [[ "$attempt" -eq 1 ]]; then
        log "snapshot: $src"
      else
        log "snapshot retry ${attempt}/3: $src"
      fi
      set +e
      run_timeout "$remaining" kopia snapshot create "${create_opts[@]}" "$src" 2>&1 | tee "$RUN_TEMP_FILE"
      rc=${PIPESTATUS[0]}
      set -e
      if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
        log "snapshot wall-clock cap reached (${timeout_sec}s) rc=${rc}: $src"
        fail=$((fail + 1))
        log "summary ok=${ok} skip=${skip} fail=${fail}"
        return 1
      fi
      if [[ "$rc" -eq 0 ]]; then
        ok=$((ok + 1))
        break
      fi
      if [[ "$attempt" -lt 3 ]] && is_rclone_startup_timeout "$RUN_TEMP_FILE"; then
        log "rclone start timeout rc=${rc}; retrying $src"
        attempt=$((attempt + 1))
        continue
      fi
      log "snapshot failed rc=${rc}: $src"
      fail=$((fail + 1))
      break
    done
    rm -f "$RUN_TEMP_FILE" || return 1
    RUN_TEMP_FILE=""
  done < <(source_list)

  log "summary ok=${ok} skip=${skip} fail=${fail}"
  if [[ "$fail" -gt 0 ]]; then
    return 1
  fi
  return 0
}

emit_outcome_notification() {
  local outcome="$1" script
  if [[ "$RUN_NOTIFICATION_SENT" -eq 1 ]]; then
    return 0
  fi
  RUN_NOTIFICATION_SENT=1
  case "$outcome" in
    warning) script='display notification "Kopia nightly maintenance needs attention" with title "kopia-nightly"' ;;
    failure) script='display notification "Kopia nightly failed; check the local log" with title "kopia-nightly"' ;;
    *) return 0 ;;
  esac
  if command -v osascript >/dev/null 2>&1 && resolve_timeout_bin >/dev/null; then
    run_timeout_with_grace 2 10 osascript -e "$script" >/dev/null 2>&1 || true
  fi
}

handle_run_signal() {
  RUN_SIGNAL_STATUS="$1"
  log "caught signal; exiting ${RUN_SIGNAL_STATUS}" >&2
  exit "$RUN_SIGNAL_STATUS"
}

finalize_run() {
  local final_status="$1" cleanup_failed=0
  trap - EXIT TERM INT
  if [[ "$RUN_FINALIZED" -eq 1 ]]; then
    exit "$final_status"
  fi
  RUN_FINALIZED=1
  if ! ensure_login_disabled; then
    cleanup_failed=1
    log "error: failed to disable one or more KopiaUI login agents during finalization" >&2
  fi
  if [[ -n "$caffeine_pid" ]]; then
    kill "$caffeine_pid" >/dev/null 2>&1 || true
    wait "$caffeine_pid" 2>/dev/null || true
    caffeine_pid=""
  fi
  if [[ -n "$RUN_TEMP_FILE" && "$RUN_TEMP_FILE" == "${TMP_DIR}/kopia-nightly."* ]]; then
    if ! rm -f "$RUN_TEMP_FILE"; then
      cleanup_failed=1
      log "error: failed to remove temporary snapshot log" >&2
    fi
    RUN_TEMP_FILE=""
  fi
  if [[ "$RUN_SIGNAL_STATUS" -ne 0 ]]; then
    final_status="$RUN_SIGNAL_STATUS"
  elif [[ "$final_status" -eq 0 && "$cleanup_failed" -ne 0 ]]; then
    final_status=1
  fi
  if [[ "$final_status" -ne 0 ]]; then
    emit_outcome_notification failure
  elif [[ "$RUN_MAINTENANCE_WARNING" -ne 0 ]]; then
    emit_outcome_notification warning
  fi
  exit "$final_status"
}

cmd_bounded_run() {
  local dry_run="$1"
  require_cmd kopia
  require_cmd rclone

  local ok=0
  local skip=0
  local src
  local timeout_sec timeout_bin
  timeout_sec="$(snapshot_timeout_sec)"
  if ! timeout_bin="$(resolve_timeout_bin)"; then
    die "missing timeout/gtimeout (coreutils) for ${timeout_sec}s wall-clock cap"
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would require kopia and rclone (present)"
    log "dry-run: would validate/create private runtime paths and set their TMPDIR before snapshots"
    log "dry-run: would cap readiness, snapshots and full maintenance at ${timeout_sec}s via ${timeout_bin} (KOPIA_NIGHTLY_TIMEOUT_SEC)"
    log "dry-run: would try repository status at most 8 times (125s per probe, finite backoff)"
    while IFS= read -r src; do
      if [[ -e "$src" ]]; then
        log "would snapshot: $src"
        ok=$((ok + 1))
      else
        log "would skip missing: $src"
        skip=$((skip + 1))
      fi
    done < <(source_list)
    log "dry-run: would run full maintenance after successful snapshots using the remaining cap"
    log "summary ok=${ok} skip=${skip} fail=0 (dry-run)"
    return 0
  fi

  require_cmd flock
  require_cmd stat
  require_cmd launchctl
  runtime_paths 1 || die "runtime paths not ready; no snapshot started"
  export TMPDIR="${TMP_DIR}"
  exec 9>>"${LOG_DIR}/nightly.lock"
  if ! flock -n 9; then
    die "another nightly run holds ${LOG_DIR}/nightly.lock"
  fi

  RUN_FINALIZED=0
  RUN_MAINTENANCE_WARNING=0
  RUN_NOTIFICATION_SENT=0
  RUN_SIGNAL_STATUS=0
  RUN_TEMP_FILE=""
  RUN_BOUNDED=1
  caffeine_pid=""
  trap 'finalize_run "$?"' EXIT
  trap 'handle_run_signal 143' TERM
  trap 'handle_run_signal 130' INT

  local start now remaining snap_rc maint_rc
  start="$(date +%s)"
  log "snapshot/maintenance wall-clock cap ${timeout_sec}s via ${timeout_bin} (includes readiness)"
  ensure_login_disabled || die "failed to disable one or more KopiaUI login agents"

  ensure_kopiaui_quit

  if command -v caffeinate >/dev/null 2>&1; then
    caffeinate -i -w "$$" >/dev/null 2>&1 &
    caffeine_pid=$!
    log "holding idle sleep (caffeinate -i -w $$)"
  else
    log "caffeinate missing; snapshots may sleep mid-upload"
  fi

  wait_repo_ready "$timeout_sec" "$start" || return 1
  if run_snapshot_loop "$timeout_sec" "$start"; then
    snap_rc=0
  else
    snap_rc=$?
    return "$snap_rc"
  fi

  now="$(date +%s)"
  remaining=$((timeout_sec - (now - start)))
  if [[ "$remaining" -le 0 ]]; then
    log "warning: full maintenance skipped (wall-clock cap exhausted)"
    RUN_MAINTENANCE_WARNING=1
    return "$snap_rc"
  fi
  if run_timeout "$remaining" kopia maintenance run --full; then
    maint_rc=0
  else
    maint_rc=$?
  fi
  log "maintenance run --full rc=${maint_rc}"
  if [[ "$maint_rc" -ne 0 ]]; then
    log "warning: full maintenance failed; snapshot result unchanged"
    RUN_MAINTENANCE_WARNING=1
  fi
  return "$snap_rc"
}

cmd_run() {
  local dry_run="$1" timeout_sec timeout_bin
  if [[ "$dry_run" -eq 1 ]]; then
    cmd_bounded_run 1
    return
  fi
  timeout_sec="$(snapshot_timeout_sec)"
  if ! timeout_bin="$(resolve_timeout_bin)"; then
    die "missing timeout/gtimeout (coreutils) for ${timeout_sec}s wall-clock cap"
  fi
  # Bound setup, readiness, snapshots and cleanup as one process group. Per-step
  # caps below use the remaining budget; this outer cap also covers hung setup.
  exec "$timeout_bin" --verbose --signal=TERM --kill-after=60 "$timeout_sec" "$0" __bounded-run
}

cmd_install() {
  local dry_run="$1"
  local dest="${HOME}/Library/LaunchAgents/${PLIST_NAME}"
  local src_runner=""

  if [[ "$dry_run" -eq 0 ]]; then
    require_cmd launchctl
    require_cmd stat
    if [[ ! -f "$dest" ]]; then
      die "dest plist missing (${dest}); apply Chezmoi from rig/home first"
    fi
    runtime_paths 1 || die "runtime paths not ready; no runner sync or scheduler changes"
  else
    log "dry-run: would validate runtime ownership, non-symlink paths and private modes"
    log "dry-run: would create missing runtime directories/log files (0700/0600), not repair existing paths"
  fi

  if src_runner="$(repo_runner_path)"; then
    if [[ "$dry_run" -eq 1 ]]; then
      log "dry-run: would /bin/cp -f ${src_runner} ${DEST_RUNNER}"
    else
      mkdir -p "$(dirname "${DEST_RUNNER}")"
      /bin/cp -f "${src_runner}" "${DEST_RUNNER}"
      /bin/chmod +x "${DEST_RUNNER}"
      log "synced dest runner from repo source"
    fi
  elif [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: KOPIA_NIGHTLY_REPO unset or source missing; would skip dest runner sync"
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would disable ${LABEL_LOGIN} and ${LABEL_UI}"
    log "dry-run: would bootstrap ${LABEL_NIGHTLY} from ${dest}"
    if [[ ! -f "$dest" ]]; then
      log "dry-run: dest plist missing — apply Chezmoi home first"
    fi
    return 0
  fi

  ensure_login_disabled || die "failed to disable one or more KopiaUI login agents"

  if agent_loaded "$LABEL_NIGHTLY"; then
    launchctl bootout "$(label_path "$LABEL_NIGHTLY")" >/dev/null 2>&1 || true
  fi
  if ! launchctl bootstrap "$(gui_domain)" "$dest"; then
    log "bootstrap failed for ${LABEL_NIGHTLY}"
    print_login_item_hint
    return 1
  fi
  launchctl enable "$(label_path "$LABEL_NIGHTLY")" >/dev/null 2>&1 || true

  if agent_loaded "$LABEL_NIGHTLY"; then
    log "loaded ${LABEL_NIGHTLY} (RunAtLoad=false; calendar 04:00; no immediate snapshot, future uploads may be enabled)"
  else
    log "${LABEL_NIGHTLY} not visible to launchctl after bootstrap"
    print_login_item_hint
    return 1
  fi
  return 0
}

cmd_doctor() {
  local check_policies="$1"
  local dest="${HOME}/Library/LaunchAgents/${PLIST_NAME}"
  local status=0
  local src_runner=""
  local repository_ready=0
  local rc

  require_cmd kopia
  require_cmd stat

  if ! runtime_paths 0; then
    log "repository status: NOT CHECKED (runtime paths not ready; cause UNKNOWN)"
    status=1
  elif ! resolve_timeout_bin >/dev/null; then
    log "repository status: NOT CHECKED (timeout/gtimeout missing; cause UNKNOWN)"
    status=1
  elif run_timeout 125 env -i HOME="${HOME}" PATH="/opt/homebrew/bin:/usr/bin:/bin" \
    TMPDIR="${TMP_DIR}" kopia repository status >/dev/null 2>&1; then
    log "repository status: ok (launchd-like env including private TMPDIR)"
    repository_ready=1
  else
    rc=$?
    log "repository status: FAIL rc=${rc} (125s cap plus 60s kill grace; cause UNKNOWN)"
    log "saved-auth/keyring retrieval failure is not proof of a wrong password; raw diagnostics suppressed"
    status=1
  fi

  if kopia_ui_running; then
    log "KopiaUI: running (nightly run will quit it)"
  else
    log "KopiaUI: not running"
  fi

  if agent_loaded "$LABEL_LOGIN"; then
    log "login agent ${LABEL_LOGIN}: LOADED (should be disabled)"
    status=1
  else
    log "login agent ${LABEL_LOGIN}: not loaded"
  fi
  if agent_loaded "$LABEL_UI"; then
    log "login agent ${LABEL_UI}: LOADED (should be disabled)"
    status=1
  else
    log "login agent ${LABEL_UI}: not loaded"
  fi

  if [[ -f "$dest" ]]; then
    log "nightly plist: present"
  else
    log "nightly plist: missing"
    status=1
  fi
  if agent_loaded "$LABEL_NIGHTLY"; then
    log "nightly agent ${LABEL_NIGHTLY}: loaded"
  else
    log "nightly agent ${LABEL_NIGHTLY}: not loaded"
    print_login_item_hint
    status=1
  fi

  if [[ -L "${DEST_RUNNER}" || (-e "${DEST_RUNNER}" && ! -f "${DEST_RUNNER}") ]]; then
    log "dest runner: FAIL (symlink or non-regular file; hash not read)"
    status=1
  elif [[ -f "${DEST_RUNNER}" ]] && src_runner="$(repo_runner_path)"; then
    local dest_hash src_hash
    dest_hash="$(file_sha256 "${DEST_RUNNER}")"
    src_hash="$(file_sha256 "${src_runner}")"
    if [[ "${dest_hash}" == "${src_hash}" ]]; then
      log "dest runner hash: match"
    else
      log "dest runner hash: MISMATCH (review source/dest diff; install requires separate approval)"
      status=1
    fi
  elif [[ -f "${DEST_RUNNER}" ]]; then
    log "dest runner present (no KOPIA_NIGHTLY_REPO source to compare)"
  else
    log "dest runner: missing"
    status=1
  fi

  if [[ "$check_policies" -eq 1 ]]; then
    if [[ "$repository_ready" -eq 1 ]]; then
      doctor_policies || status=1
    else
      log "policy list: NOT CHECKED (repository status not ready)"
      status=1
    fi
  fi

  return "$status"
}

doctor_policies() {
  require_cmd python3
  log "diffing script list against live 04:00 policies (one policy list --json)"
  local listed json_tmp rc
  listed="$(source_list)"
  json_tmp="$(mktemp "${TMP_DIR}/policies.XXXXXX")"
  if run_timeout 90 env -i HOME="${HOME}" PATH="/opt/homebrew/bin:/usr/bin:/bin" \
    TMPDIR="${TMP_DIR}" kopia policy list --json >"${json_tmp}" 2>/dev/null; then
    :
  else
    rc=$?
    rm -f "${json_tmp}"
    log "policy list: FAIL rc=${rc} (90s cap plus 60s kill grace; cause UNKNOWN; raw diagnostics suppressed)" >&2
    return "$rc"
  fi
  set +e
  LISTED_SOURCES="${listed}" LAUNCHD_ONLY_ARCHIVE="${LAUNCHD_ONLY_ARCHIVE}" \
    HOME="${HOME}" python3 - "${json_tmp}" <<'PY'
import json
import os
import sys

home = os.environ["HOME"].rstrip("/")
launchd_only_archive = os.environ["LAUNCHD_ONLY_ARCHIVE"]
listed = [line for line in os.environ.get("LISTED_SOURCES", "").splitlines() if line]
listed_set = set(listed)

def is_0400(sched):
    if not isinstance(sched, dict):
        return False
    tod = sched.get("timeOfDay") or sched.get("timesOfDay") or []
    if not isinstance(tod, list):
        return False
    for entry in tod:
        if not isinstance(entry, dict):
            continue
        if int(entry.get("hour", -1)) == 4 and int(entry.get("min", -1)) == 0:
            return True
    return False

def target_path(target):
    if isinstance(target, dict):
        return (target.get("path") or "").rstrip("/")
    if isinstance(target, str) and ":" in target:
        return target.rsplit(":", 1)[-1].rstrip("/")
    return ""

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        policies = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    print(f"[kopia-nightly] policy list json: {exc}", file=sys.stderr)
    sys.exit(1)

if not isinstance(policies, list):
    print("[kopia-nightly] policy list json: expected a list", file=sys.stderr)
    sys.exit(1)

live_0400 = set()
for policy in policies:
    path = target_path(policy.get("target"))
    if not path:
        continue
    if is_0400(policy.get("scheduling") or {}):
        live_0400.add(path)

drift = 0
for path in listed:
    if path == launchd_only_archive:
        if path in live_0400:
            print(f"[kopia-nightly] unexpected 04:00 policy for launchd-only source: {path}")
            drift = 1
        else:
            print(f"[kopia-nightly] launchd-only source ok: {path}")
    elif path in live_0400:
        print(f"[kopia-nightly] policy 04:00 ok: {path}")
    else:
        print(f"[kopia-nightly] policy 04:00 missing or unread: {path}")
        drift = 1

for path in sorted(live_0400 - listed_set):
    if path == home:
        print(f"[kopia-nightly] note: {path} itself has a 04:00 policy but is intentionally not snapshotted")
        continue
    print(f"[kopia-nightly] extra 04:00 source not in script list: {path}")
    drift = 1

sys.exit(drift)
PY
  rc=$?
  set -e
  rm -f "${json_tmp}"
  return "$rc"
}

main() {
  : "${HOME:?HOME is unset}"

  if [[ "${1:-}" == __mba-role ]]; then
    [[ "$#" -eq 1 ]] || return 2
    is_mba_role 2>/dev/null || return $?
    return 0
  fi
  if [[ "${1:-}" == __bounded-run ]]; then
    [[ "$#" -eq 1 ]] || die "private bounded mode does not accept public options"
    guard_nightly_role
    cmd_bounded_run 0
    return
  fi

  local dry_run=0
  local mode="run"
  local policies=0
  local arg

  for arg in "$@"; do
    case "$arg" in
      -h | --help)
        usage
        return 0
        ;;
    esac
  done

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --policies)
        policies=1
        shift
        ;;
      install)
        mode="install"
        shift
        ;;
      doctor)
        mode="doctor"
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done

  [[ "$mode" == doctor ]] || guard_nightly_role
  case "$mode" in
    run)
      cmd_run "$dry_run"
      ;;
    install)
      cmd_install "$dry_run"
      ;;
    doctor)
      cmd_doctor "$policies"
      ;;
    *)
      die "unknown mode: $mode"
      ;;
  esac
}

main "$@"
