#!/usr/bin/env bash
set -euo pipefail

printf 'kopia|%s\n' "$*" >>"${KOPIA_NIGHTLY_TEST_STATE:?}/calls"
scenario="${KOPIA_NIGHTLY_TEST_SCENARIO:-success}"

case "${1:-} ${2:-}" in
  'repository status')
    [[ "$scenario" != "readiness_exhaustion" ]]
    ;;
  'snapshot create')
    if [[ "$scenario" == "snapshot_failure" || "$scenario" == "notification_failure" || "$scenario" == "combined_failure" ]]; then
      printf 'fixture snapshot failure\n' >&2
      exit 7
    fi
    ;;
  'maintenance run')
    if [[ "$scenario" == "maintenance_warning" || "$scenario" == "combined_failure" ]]; then
      exit 9
    fi
    ;;
esac
