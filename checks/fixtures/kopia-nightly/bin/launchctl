#!/usr/bin/env bash
set -euo pipefail

state="${KOPIA_NIGHTLY_TEST_STATE:?}"
printf 'launchctl|%s\n' "$*" >>"$state/calls"

if [[ "${1:-}" == "print" ]]; then
  exit 1
fi

if [[ "${1:-}" == "disable" ]]; then
  count=0
  if [[ -f "$state/disable-count" ]]; then
    read -r count <"$state/disable-count"
  fi
  count=$((count + 1))
  printf '%s\n' "$count" >"$state/disable-count"
  if [[ ("${KOPIA_NIGHTLY_TEST_SCENARIO:-}" == "cleanup_failure" || "${KOPIA_NIGHTLY_TEST_SCENARIO:-}" == "combined_failure") && "$count" -gt 2 ]]; then
    exit 42
  fi
fi
