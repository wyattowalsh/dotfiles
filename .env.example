# Copy to a private, untracked file (e.g. ~/.zshrc.local exports).
# MCP servers, client JSON, and skills: https://github.com/wyattowalsh/agents
# Apple text overlay is local-only (never git): ~/.config/apple-text/expansions.local.json

MCPHUB_BEARER_TOKEN=
BRAVE_API_KEY=
DOTFILES_APPLE_TEXT_OVERLAY=
DOTFILES_APPLE_TEXT_STATE=
DOTFILES_APPLE_ICLOUD=

# music-likes sources ~/.zsh/secrets.env and ~/.config/music-likes/secrets.env
# from launchd. Keep both credential files untracked and mode 0600.
MUSIC_LIKES_SPOTIFY_CLIENT_ID=
MUSIC_LIKES_SPOTIFY_CLIENT_SECRET=
MUSIC_LIKES_SPOTIFY_REFRESH_TOKEN=
MUSIC_LIKES_SOULSEEK_USER=
MUSIC_LIKES_SOULSEEK_PASS=
