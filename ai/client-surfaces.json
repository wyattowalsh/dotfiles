{
  "$schema": "./schemas/client-surfaces.schema.json",
  "clients": [
    {
      "id": "claude",
      "surface": "~/.config/claude/mcp.json",
      "format": "json",
      "mcp": {
        "default": "mcphub",
        "fallback": "direct"
      }
    },
    {
      "id": "codex",
      "surface": "~/.codex/config.toml",
      "format": "toml",
      "mcp": {
        "default": "mcphub",
        "fallback": "direct"
      }
    },
    {
      "id": "gemini",
      "surface": "~/.gemini/settings.json",
      "format": "json",
      "mcp": {
        "default": "mcphub",
        "fallback": "direct"
      },
      "notes": "Local config must not contain literal MCPHub bearer tokens."
    },
    {
      "id": "copilot",
      "surface": "~/.copilot/mcp-config.json",
      "format": "json",
      "mcp": {
        "default": "mcphub",
        "fallback": "direct"
      }
    },
    {
      "id": "opencode",
      "surface": "~/.config/opencode/opencode.json",
      "format": "json",
      "mcp": {
        "default": "mcphub",
        "fallback": "direct"
      },
      "notes": "Model defaults should be reviewed separately from MCP migration."
    }
  ]
}

