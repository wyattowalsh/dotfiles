{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/mcphub.schema.json",
  "title": "MCPHub Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "transport", "endpoints", "fallbackServers"],
  "properties": {
    "$schema": {
      "const": "./schemas/mcphub.schema.json"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "bearerTokenEnv"],
      "properties": {
        "type": {
          "const": "stdio"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "bearerTokenEnv": {
          "const": "MCPHUB_BEARER_TOKEN"
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "groups"],
      "properties": {
        "all": {
          "type": "string",
          "pattern": "^https?://"
        },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "fallbackServers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
