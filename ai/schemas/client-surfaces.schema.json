{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/client-surfaces.schema.json",
  "title": "AI Client Surfaces",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "clients"],
  "properties": {
    "$schema": {
      "const": "./schemas/client-surfaces.schema.json"
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "format", "mcp"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": ["json", "toml"]
          },
          "mcp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["default", "fallback"],
            "properties": {
              "default": {
                "enum": ["mcphub", "direct"]
              },
              "fallback": {
                "enum": ["direct", "none"]
              }
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
